---
/* The search control: a small frosted bar, fixed to the bottom centre of
   every page — where the prototype's page-switcher pill sat
   (`reference/prototype/css/nav.css:120`). Nahian, 2026-09-20.

   It carries its own ground rather than following the nav's light/dark
   state: the nav knows what is behind the TOP of the frame, and this sits
   at the bottom, where the answer is different. A dark frosted pill with
   a light hairline reads on the street, on the night sections and on
   paper alike, which is the only treatment that survives all three.

   The client's sheet lists a search button (Sheet1, B2); what it opens is
   not designed yet, so this is the control only. */
---

<button class="search" type="button" data-search>
  <svg class="search__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
    <path
      d="m16.6 16.6 4 4"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    ></path>
  </svg>
  <span class="search__label">Search</span>
</button>

<style>
  .search {
    position: fixed;
    left: 50%;
    /* Clear of the home indicator on a handset. */
    bottom: calc(var(--search-gap) + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    /* Above the pinned sections and the drawer's backdrop alike. */
    z-index: calc(var(--z-modal) + 1);

    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--s-3);
    /* Wide enough to read as a bar rather than a button, and 44px tall
             so it is a real tap target. */
    min-width: 13rem;
    min-height: var(--search-h);
    padding: var(--s-2) var(--s-5);
    border-radius: var(--r-full);

    border: 1px solid var(--glass-line);
    background: var(--glass);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: var(--e-3);

    color: var(--glass-ink);
    font-family: inherit;
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: -0.005em;
    cursor: pointer;
    transition:
      background var(--t-fast) var(--ease-io),
      border-color var(--t-fast) var(--ease-io);
  }

  .search:hover {
    background: var(--glass-lift);
    border-color: var(--glass-line-lift);
  }

  .search:focus-visible {
    outline: 2px solid var(--pink);
    outline-offset: 3px;
  }

  .search__icon {
    width: 1.15em;
    height: 1.15em;
    flex: none;
    opacity: 0.86;
  }

  .search__label {
    opacity: 0.86;
  }

  @media (max-width: 767px) {
    .search {
      min-width: 11rem;
      padding-inline: var(--s-4);
    }
  }
</style>
