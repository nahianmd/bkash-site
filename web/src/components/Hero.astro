---
/* Section 1: Hero — one camera through one street.
   specs/sections/hero.md · specs/hero/plan.md

   Four beats over four screens of travel: the street, then Amena,
   Rahim, Faysal. The pin is `--vh` tall; the section provides the
   travel. lib/hero.ts drives the camera; this file is composition. */
import HeroScene from './HeroScene.astro';
import BirdOverlay from './BirdOverlay.astro';
---

<section class="hero" data-hero aria-label="Stories from one neighbourhood">
  <div class="hero__pin" data-hero-pin>
    <HeroScene />

    <div class="hero__chrome">
      <!-- Beat 0. Top-right, in the sky. The plan said bottom-right; the
           picture disagreed — Faysal rides through the lower right, and on
           a phone the whole bottom third is where the people are. The sky
           is the one region this plate leaves open at every width. -->
      <div class="hero__open on-photo" data-hero-open>
        <h1 class="t-hero">Powering financial access</h1>
        <p class="t-lead hero__line">Across millions of lives</p>
        <p class="t-sm hero__cue">Scroll to meet them</p>
      </div>

      <!-- Beats 1–3. One block each, stacked at the same spot; the
           camera's focus drives which is visible. Eyebrow is the ROLE
           (decided 2026-09-18), in scrim ink — pink on the scrim is
           audit H4 again.

           Copy is the client's deck (`assets/Website_N_1.pdf`, p.2),
           assigned by ROLE, not by the name beside it there: the deck
           labels the agent line "Faisal" and the merchant line
           "Rahim", and it is the other way round. Order is customer,
           agent, merchant — Amena, Rahim, Faysal (hero-beats.ts).
           These blocks are indexed by beat. Nahian, 2026-09-20. -->
      <div class="hero__caps">
        <div class="hero__cap on-photo" data-hero-cap="1">
          <p class="t-eyebrow hero__role">Customer</p>
          <h2 class="t-h2">7 in 10 adults in Bangladesh</h2>
          <p class="t-lead hero__line">Control their money with bKash</p>
        </div>
        <div class="hero__cap on-photo" data-hero-cap="2">
          <p class="t-eyebrow hero__role">Agent</p>
          <h2 class="t-h2">At least one human ATM every 2 km</h2>
          <p class="t-lead hero__line">The largest agent network in Bangladesh</p>
        </div>
        <div class="hero__cap on-photo" data-hero-cap="3">
          <p class="t-eyebrow hero__role">Merchant</p>
          <h2 class="t-h2">From floating stalls to digital storefronts</h2>
          <p class="t-lead hero__line">Empowering millions of cashless commerce</p>
        </div>
      </div>
    </div>

    <!-- The bird rides this pin. Its window shrinks over this very frame
         once the beats are done — no second section, no second frame. -->
    <BirdOverlay />
  </div>

  <!-- The nav is transparent while this marker is below its band
       (lib/nav.ts). The plate's top is bright sky; the nav carries its
       own scrim, and verify measures it. -->
  <div data-nav-dark-end></div>
</section>

<style>
  .hero {
    position: relative;
    /* Four beats, about one screen of travel each (plan). The pin is
                         one --vh; the section is the travel. Never 100vh. */
    /* One screen of pin plus the travel: the hero's beats and the bird's
               reveal, on the same pin. hero.ts writes --hero-screens from the two
               configs; 6.5 is the matching fallback. Never 100vh. */
    height: calc(var(--vh) * var(--hero-screens, 6.5));
    background: var(--night);
  }

  .hero__pin {
    position: relative;
    height: var(--vh);
    overflow: hidden;
    background: var(--night);
  }

  .hero__chrome {
    position: absolute;
    inset: 0;
    z-index: var(--z-chrome);
    pointer-events: none;
  }

  /* The claim sits at the foot of the frame, in the captions' column,
     and leaves as Amena's caption arrives in the same place (Nahian,
     2026-09-20). Rahim's stall is behind it at the wide shot; the
     ground is the scrim. */
  .hero__open {
    position: absolute;
    left: var(--gutter);
    bottom: calc(var(--gutter) + var(--s-6));
    width: max-content;
    max-width: min(52vw, 44rem);
  }

  .hero__line {
    margin-top: var(--s-4);
    color: var(--scrim-ink);
  }

  .hero__cue {
    margin-top: var(--s-5);
    color: var(--on-night-2);
  }

  /* The column spans gutter to gutter so a caption can anchor to either
     edge; each block still measures 38rem, so beats 1 and 3 wrap exactly
     as they did when the column itself was 38rem wide. */
  .hero__caps {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(var(--gutter) + var(--s-6));
  }

  .hero__cap {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: min(38rem, 100%);
    opacity: 0;
    will-change: opacity, transform;
  }

  /* Beat 2 (Agent) mirrors to the right edge. Not a composition
     preference — the scrim was the problem. `.on-photo` darkens its text
     block plus --s-6 on every side and then feathers out over a further
     5rem, and Rahim stands at x 0.3163 with the camera at x 0.37, which
     puts him squarely under a left-anchored caption's underlay. He read
     as dimmed at the exact beat that is meant to be focusing on him,
     which fights Rule 4: the subject stays full while everything else
     steps back. Moving the block off him is the fix; right-aligning it
     is what keeps it looking deliberate rather than nudged.
     Nahian, 2026-09-22. */
  @media (min-width: 768px) {
    .hero__cap[data-hero-cap='2'] {
      left: auto;
      right: 0;
      text-align: right;
    }
  }

  .hero__role {
    color: var(--scrim-ink);
    opacity: 0.82;
    margin-bottom: var(--s-3);
  }

  /* 390: headline in the bottom third, subjects in the middle third
     (Rule 3). Same block, moved. */
  @media (max-width: 767px) {
    /* Top third: the sky. The people occupy the middle and bottom thirds
                     of the phone's slice (Rule 3). */
    .hero__open {
      bottom: auto;
      top: calc(var(--nav-h) + var(--s-6));
      max-width: none;
      width: calc(100% - var(--gutter) * 2);
    }

    /* The ground at 390 (Nahian, 2026-09-22: the black box behind the
       headline "doesn't look good"). Same change in kind as the 2026-09-20
       softening — the number and the contract are unchanged, only the edge.

       The block is full-bleed at this width, so `.on-photo`'s soft rectangle
       had no short side to hug: every line dragged a gutter-to-gutter bar,
       and the one-line cue dragged the widest bar of all. It read as a slab
       laid over the sky rather than a ground under the text.

       So on a phone the ground anchors to the top edge of the frame instead
       of floating. It bleeds past both gutters and runs up under the nav,
       which leaves it no visible top, left or right edge to read as a box;
       the pin's overflow:hidden does the clipping. What is left is the sky
       growing heavier toward the top — a photographic convention, not a
       panel.

       The contract holds exactly: --scrim-strength across the whole text
       block, fading only BELOW the last line, over --scrim-feather. The
       4.5:1 floor derived in tokens.css still passes by construction. */
    .hero__open::before {
      inset:
        calc(-1 * (var(--nav-h) + var(--s-6)))
        calc(-1 * var(--gutter))
        calc(-1 * (var(--scrim-bleed) + var(--scrim-feather)));
      background: linear-gradient(
        to bottom,
        var(--scrim-color) 0,
        var(--scrim-color) calc(100% - var(--scrim-feather)),
        transparent 100%
      );
      /* The gradient is the feather now. A radius and a glow are what a
         floating box needs; this one has no free edges to soften. */
      border-radius: 0;
      box-shadow: none;
    }

    .hero__caps {
      bottom: calc(var(--gutter) + var(--s-8));
    }
  }

  /* No JS: beat 0 as a composed still, no travel. Reduced motion takes
     the same path from lib/hero.ts by adding .hero--static. */
  :global(.no-js) .hero,
  .hero.hero--static {
    height: var(--vh);
  }
</style>

<script>
  import { initHero } from '../lib/hero';
  initHero();
</script>
