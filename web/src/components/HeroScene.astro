---
/* The scene: the plate and the three cutouts, through astro:assets.

   Shared by two sections. The hero animates it — a camera pushes
   through it beat by beat. The bird renders it STATIC at beat 3 as
   the content under its mask, which is what makes the handover
   exact by construction: same component, same assets, same pixels.

   The plate has NO people of its own (2026-09-19: the three figures
   removed; replate 2026-09-22, 1678×937). The cutouts are the only people, always
   visible, placed as fractions of the plate — nothing to ghost, and
   never an opacity ramp on anyone. Focus is the recede rule on the
   street and the other two.

   Sizing is the camera's job, not Astro's — `layout="none"` on every
   image, and the scene box is set by lib/hero.ts from the plate's
   cover fit. The no-JS fallback is plain CSS cover, below.        */
import { Picture } from 'astro:assets';

import plate from '../assets/img/hero/plate.png';
import { BEATS } from '../lib/hero-beats';

const sharp = import.meta.glob<{ default: ImageMetadata }>('../assets/img/hero/*.png', {
  eager: true,
});
const cut = (id: string) => sharp[`../assets/img/hero/${id}.png`].default;
const people = BEATS.filter((b) => b.cut).map((b) => ({
  id: b.id,
  cut: b.cut!,
  img: cut(b.id),
}));

/* The cutout boxes as CSS, from the same numbers the camera uses, so the
   no-JS still places them too (the gate forbids inline styles). The
   box's aspect is the drawing's. */
const cutCss = people
  .map(
    (p) =>
      `.scene__cut[data-hero-cut="${p.id}"]{left:${(p.cut.x * 100).toFixed(2)}%;top:${(p.cut.y * 100).toFixed(2)}%;width:${(p.cut.w * 100).toFixed(2)}%;aspect-ratio:${p.img.width}/${p.img.height}${p.cut.soft ? `;filter:blur(${p.cut.soft}px)` : ''}}`,
  )
  .join('');

/* The widths cap each variant at about 2x its largest display size.
   The ladder tops out at the plate's OWN width, read from the import
   rather than typed: it is the source, Astro does not enlarge, so asking
   for more only emits duplicates — and the plate has been replaced twice
   in three days (2748 -> 1679 -> 1678 wide). A typed number desyncs on
   the next swap; this cannot.

   The plate at 4x zoom on 1920 would want ~7730 and has 1678 — the
   tightest beat is a 4.6x stretch (it was 2.8x on the 2748 plate).
   A cutout's largest size is its box fraction x the plate's display
   width x its beat's zoom.

   `fallbackFormat` is webp on EVERY image here, plate included. Every
   source in this folder is now a PNG, and a PNG source gets a PNG
   fallback ladder: the cutouts' was 13.8MB of the build, and the plate's
   was 8.3MB the moment it stopped being a JPEG (2026-09-22) — one variant
   re-encoded LARGER than the 2.1MB source. No browser that supports
   <picture> and reaches the <img> at all lacks WebP except Safari 13 and
   older. Nothing is saved on a visitor's connection — the fallback is
   never fetched when a <source> matches — this is deploy weight and
   build time. */
---

<style is:global set:html={cutCss}></style>

<div class="scene" data-hero-scene>
  <Picture
    src={plate}
    alt="A neighbourhood street at golden hour"
    widths={[390, 640, 768, 1024, 1280, plate.width]}
    sizes="100vw"
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    layout="none"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    pictureAttributes={{ class: 'scene__plate' }}
    data-hero-plate
  />

  {people.map((p) => (
    <div class="scene__cut" data-hero-cut={p.id}>
      <Picture
        src={p.img}
        alt=""
        widths={[300, 600, 1000, p.img.width]}
        sizes="50vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        layout="none"
      />
    </div>
  ))}
</div>

<style is:global>
  /* Global on purpose: <Picture> renders its own elements, which do
     not carry this component's scope attribute. Every selector is
     prefixed with .scene so the reach is the same as scoping. */

  .scene {
    position: absolute;
    inset: 0;
    /* Origin 0 0 keeps the camera maths solvable: after
               translate(tx, ty) scale(s) the box is exactly
               (tx, ty, W*s, H*s), so the cover clamp is arithmetic. */
    transform-origin: 0 0;
    will-change: transform;
  }

  .scene__plate,
  .scene__plate img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  /* The phone's slice of the wide plate (spec, 390): a window at
     ~46% across contains Amena, the tea stall and Faysal. Only the
     no-JS path uses this — with JS the scene box carries fx. */
  @media (max-width: 767px) {
    .scene__plate img {
      object-position: 46% 50%;
    }
  }

  /* Cutouts: fractions of the scene box (the generated rules above; JS
     writes the same on resize), always visible. */
  .scene__cut {
    position: absolute;
    pointer-events: none;
    user-select: none;
    will-change: opacity, transform;
  }

  .scene__cut picture,
  .scene__cut img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
