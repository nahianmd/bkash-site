---
/* The scene: the plate and the three cutouts, through astro:assets.

   Shared by two sections. The hero animates it — a camera pushes
   through it beat by beat. The bird renders it STATIC at beat 3 as
   the content under its mask, which is what makes the handover
   exact by construction: same component, same assets, same pixels.

   The plate has NO people of its own (2026-09-19: the three figures
   removed, 2748×1536). The cutouts are the only people, always
   visible, placed as fractions of the plate — nothing to ghost. Each
   is one drawing twice: sharp, and a pre-softened twin shown while it
   is small on screen (tools/soft-twins.mjs), crossfaded by the
   camera's zoom. Focus is the recede rule on the street and the other
   two, never an opacity ramp on the subject.

   Sizing is the camera's job, not Astro's — `layout="none"` on every
   image, and the scene box is set by lib/hero.ts from the plate's
   cover fit. The no-JS fallback is plain CSS cover, below.        */
import { Picture } from 'astro:assets';

import plate from '../assets/img/hero/plate.jpeg';
import { BEATS } from '../lib/hero-beats';

const sharp = import.meta.glob<{ default: ImageMetadata }>('../assets/img/hero/*.png', {
  eager: true,
});
const cut = (id: string) => sharp[`../assets/img/hero/${id}.png`].default;
const soft = (id: string) => sharp[`../assets/img/hero/${id}-soft.png`].default;
const people = BEATS.filter((b) => b.cut).map((b) => ({ id: b.id, cut: b.cut!, img: cut(b.id) }));

/* The cutout boxes as CSS, from the same numbers the camera uses, so the
   no-JS still places them too (the gate forbids inline styles). The
   box's aspect is the drawing's. */
const cutCss = people
  .map(
    (p) =>
      `.scene__cut[data-hero-cut="${p.id}"]{left:${(p.cut.x * 100).toFixed(2)}%;top:${(p.cut.y * 100).toFixed(2)}%;width:${(p.cut.w * 100).toFixed(2)}%;aspect-ratio:${p.img.width}/${p.img.height}}`,
  )
  .join('');

/* The widths cap each variant at about 2x its largest display size:
   the plate at 4x zoom on 1920 would want 7680 and has 2748 — the
   tightest beat is a 2.8x stretch, down from 4.8x. A cutout's largest
   size is its box fraction x the plate's display width x its beat's
   zoom; the soft twin only ever shows small. */
---

<style is:global set:html={cutCss}></style>

<div class="scene" data-hero-scene>
  <Picture
    src={plate}
    alt="A neighbourhood street at golden hour"
    widths={[390, 640, 768, 1024, 1280, 1600, 1920, 2748]}
    sizes="100vw"
    formats={['avif', 'webp']}
    layout="none"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    pictureAttributes={{ class: 'scene__plate' }}
    data-hero-plate
  />

  {people.map((p) => (
    <div class="scene__cut" data-hero-cut={p.id}>
      <Picture
        src={soft(p.id)}
        alt=""
        widths={[200, 400]}
        sizes="12vw"
        formats={['avif', 'webp']}
        layout="none"
        pictureAttributes={{ 'data-cut-soft': '' }}
      />
      <Picture
        src={p.img}
        alt=""
        widths={[500, 1000, p.img.width]}
        sizes="50vw"
        formats={['avif', 'webp']}
        layout="none"
        pictureAttributes={{ 'data-cut-sharp': '' }}
      />
    </div>
  ))}
</div>

<style is:global>
  /* Global on purpose: <Picture> renders its own elements, which do
     not carry this component's scope attribute. Every selector is
     prefixed with .scene so the reach is the same as scoping. */

  .scene {
    position: absolute;
    inset: 0;
    /* Origin 0 0 keeps the camera maths solvable: after
         translate(tx, ty) scale(s) the box is exactly
         (tx, ty, W*s, H*s), so the cover clamp is arithmetic. */
    transform-origin: 0 0;
    will-change: transform;
  }

  .scene__plate,
  .scene__plate img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  /* The phone's slice of the wide plate (spec, 390): a window at
     ~46% across contains Amena, the tea stall and Faysal. Only the
     no-JS path uses this — with JS the scene box carries fx. */
  @media (max-width: 767px) {
    .scene__plate img {
      object-position: 46% 50%;
    }
  }

  /* Cutouts: fractions of the scene box (the generated rules above; JS
     writes the same on resize), always visible. Two copies stacked:
     the soft twin under the sharp one, crossfaded by the zoom. */
  .scene__cut {
    position: absolute;
    pointer-events: none;
    user-select: none;
    will-change: opacity, transform;
  }

  .scene__cut picture,
  .scene__cut img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Without JS the camera never zooms: the soft twin is the still. */
  :global(.no-js) .scene__cut [data-cut-sharp] {
    opacity: 0;
  }
</style>
