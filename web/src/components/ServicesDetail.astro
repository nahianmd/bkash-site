---
/* The sixteen services, selectable — its own section on white, in flow,
   reached from the phone section's "See details of our services". The
   card flips to the chosen service; the other fifteen recede. Desktop:
   stage left, grid right. Phone: the card on top, the sixteen beneath.
   specs/sections/services.md (revised 2026-09-19, late). */
import { SERVICES } from '../lib/services';

const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/icons/*.svg', {
  eager: true,
});
const icon = (id: string) => icons[`../assets/icons/${id}.svg`].default;
---

<section
  class="svcd"
  id="services-detail"
  data-services-detail
  aria-label="Our sixteen services"
>
  <div class="wrap svcd__in">
    <!-- The stage: a 3D card that flips to the chosen service, the copy
         beneath it. -->
    <div class="stage" data-stage aria-live="polite">
      <div class="card3d" data-card>
        <div class="card3d__flip" data-card-flip>
          <div class="card3d__face card3d__face--front" data-face="0">
            <img data-face-icon alt="" width="64" height="64" />
          </div>
          <div class="card3d__face card3d__face--back" data-face="1">
            <img data-face-icon alt="" width="64" height="64" />
          </div>
        </div>
      </div>
      <div class="stage__copy" data-stage-copy>
        <h2 class="t-h1 stage__title" data-stage-title></h2>
        <p class="t-lead stage__line" data-stage-line></p>
      </div>
    </div>

    <!-- The sixteen, in the app's order; the lattice keeps the home
         screen's rhythm (services-detail.ts writes --col / --row). -->
    <div class="grid" data-grid>
      <div class="grid__in" data-grid-in role="list">
        {SERVICES.map((svc, i) => (
          <button
            class="cell"
            type="button"
            data-cell={i}
            role="listitem"
            aria-label={svc.name}
            aria-pressed="false"
          >
            <span class="cell__icon">
              <img src={icon(svc.id).src} width="64" height="64" alt="" loading="lazy" />
            </span>
            <span class="cell__label t-sm">{svc.name}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .svcd {
    background: var(--paper);
    color: var(--ink);
    /* Clear air above, between the phone at rest and the sixteen. */
    padding-block: var(--s-11) var(--s-10);
  }
  .svcd__in {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--s-10);
  }

  /* ---- the stage ---------------------------------------------------- */
  .stage {
    display: grid;
    justify-items: center;
    gap: var(--s-6);
    perspective: 1200px;
  }
  /* The idle breath: a few degrees, slow, on a wrapper so it never fights
     the flip. */
  .card3d {
    width: min(24rem, 40vh);
    aspect-ratio: 1;
    transform-style: preserve-3d;
    animation: breathe 7s ease-in-out infinite alternate;
  }
  @keyframes breathe {
    from {
      transform: rotateY(-5deg) rotateX(2deg);
    }
    to {
      transform: rotateY(5deg) rotateX(-2deg);
    }
  }
  .card3d__flip {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform var(--t-veil) var(--ease);
  }
  .card3d__flip.is-flipped {
    transform: rotateY(180deg);
  }
  .card3d__face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: var(--r-lg);
    background: var(--paper-2);
    box-shadow: var(--e-3);
    backface-visibility: hidden;
  }
  .card3d__face--back {
    transform: rotateY(180deg);
  }
  .card3d__face img {
    width: 48%;
    height: 48%;
  }
  .stage__copy {
    text-align: center;
    transition: opacity var(--t-base) var(--ease-io);
  }
  .stage__title {
    margin-inline: auto;
  }
  .stage__line {
    margin: var(--s-3) auto 0;
    color: var(--ink-2);
  }

  /* ---- the grid ----------------------------------------------------- */
  .grid__in {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: var(--row, 6rem);
    width: 100%;
  }
  .cell {
    position: relative;
    display: grid;
    place-items: center;
    color: var(--ink);
    border-radius: var(--r-md);
    cursor: pointer;
    transition:
      opacity var(--recede-t) var(--ease-io),
      filter var(--recede-t) var(--ease-io);
  }
  .cell__icon {
    /* The disc: 55% of the column pitch, like the screenshot's. */
    width: calc(var(--col, 6rem) * 0.55);
    aspect-ratio: 1;
    border-radius: var(--r-full);
    background: var(--paper-2);
    display: grid;
    place-items: center;
  }
  .cell__icon img {
    width: 56%;
    height: 56%;
  }
  .cell__label {
    position: absolute;
    top: calc(50% + var(--col, 6rem) * 0.275 + var(--s-2));
    left: 0;
    right: 0;
    text-align: center;
    line-height: 1.2;
  }
  /* The chosen one is full; the fifteen recede (Rule 4). */
  .cell:not(.is-on) {
    opacity: var(--recede-opacity);
    filter: saturate(var(--recede-saturate)) brightness(var(--recede-brightness));
  }
  /* A hairline of pink, not a band (Nahian, 2026-09-23). */
  .cell.is-on .cell__icon {
    box-shadow: 0 0 0 1px var(--pink);
  }
  .cell:focus-visible {
    outline: 2px solid var(--pink);
    outline-offset: 2px;
  }

  @media (max-width: 767px) {
    /* On a phone the extra above goes — 128px of blank white is a
             screenful to scroll past — and the section takes the phone
             rhythm like every other. */
    .svcd {
      padding-block: var(--section-pad-phone);
    }
    .svcd__in {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
    .card3d {
      width: min(60vw, 40vh);
    }
    .stage__title {
      font-size: var(--fs-h2);
      line-height: 1.12;
      letter-spacing: -0.022em;
    }
    /* The sixteen as a row that slides: 56px icons, snap to item, the
             chosen one centred; a swipe selects. Labels off — the card names
             the service. */
    .grid {
      width: 100vw;
      margin-inline: calc(-1 * var(--gutter));
    }
    .grid__in {
      display: flex;
      gap: var(--s-4);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-inline: calc(50vw - 28px);
      padding-block: var(--s-3);
    }
    .grid__in::-webkit-scrollbar {
      display: none;
    }
    .cell {
      flex: 0 0 56px;
      height: 56px;
      scroll-snap-align: center;
      --col: 56px;
    }
    .cell .cell__icon {
      width: 56px;
    }
    .cell__label {
      display: none;
    }
  }
</style>

<script>
  import { initServicesDetail } from '../lib/services-detail';
  initServicesDetail();
</script>
