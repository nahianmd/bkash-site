---
/* The bird's still — shown ONLY without JS or under reduced motion.
   The live bird is BirdOverlay.astro inside the hero's pin; this is
   the same poster with no machinery: the plate, clipped to the mark,
   sized by CSS, copy beneath. */
import { getImage } from 'astro:assets';
import plate from '../assets/img/hero/plate.jpg';
import { FACETS, facetPath, BIRD_W, BIRD_H } from '../lib/bird-shape';

const paths = FACETS.map((_, i) => facetPath(i));
const img = await getImage({ src: plate, width: 1600, format: 'webp' });
---

<section class="bird-still" aria-label="The bKash mark, framing the street">
  <svg
    class="bird-still__mark"
    viewBox={`0 0 ${BIRD_W} ${BIRD_H}`}
    role="img"
    aria-label="The bKash bird, with the neighbourhood street inside it"
  >
    <defs>
      <clipPath id="bird-still-clip">
        {paths.map((d) => (
          <path d={d}></path>
        ))}
      </clipPath>
    </defs>
    <image
      href={img.src}
      width={BIRD_W}
      height={BIRD_H}
      preserveAspectRatio="xMidYMid slice"
      clip-path="url(#bird-still-clip)"
    />
    <g class="bird-still__lines" fill="none">
      {paths.map((d) => (
        <path d={d} vector-effect="non-scaling-stroke"></path>
      ))}
    </g>
  </svg>
  <div class="bird-still__copy">
    <p class="t-eyebrow bird-still__eyebrow">Across Bangladesh</p>
    <h2 class="t-h1 bird-still__title">Writing Millions of Stories in Motion</h2>
  </div>
</section>

<style>
  .bird-still {
    display: none;
    padding: var(--s-9) var(--gutter);
    background: var(--paper);
    text-align: center;
  }

  :global(.no-js) .bird-still {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .bird-still {
      display: block;
    }
  }

  .bird-still__mark {
    display: block;
    margin-inline: auto;
    height: calc(var(--vh) * 0.58);
    width: auto;
  }

  .bird-still__lines path {
    stroke: var(--paper);
    stroke-width: 2;
  }

  .bird-still__copy {
    margin-top: var(--s-6);
    color: var(--ink);
  }

  .bird-still__eyebrow {
    color: var(--ink-3);
    margin-bottom: var(--s-4);
  }

  .bird-still__title {
    margin-inline: auto;
  }

  @media (max-width: 767px) {
    .bird-still__mark {
      height: auto;
      width: 86%;
    }
  }
</style>
