---
/* The bird's still — shown ONLY without JS or under reduced motion.
   The live bird is BirdOverlay.astro inside the hero's pin; this is
   the same poster with no machinery: the plate, clipped to the mark,
   sized by CSS, copy beneath. */
import { getImage } from 'astro:assets';
import plate from '../assets/img/hero/plate.png';
import { FACETS, facetPath, BIRD_W, BIRD_H } from '../lib/bird-shape';
import { castWindows } from '../lib/bird-cast';
import { BEATS, PLATE } from '../lib/hero-beats';

const paths = FACETS.map((_, i) => facetPath(i));
const img = await getImage({ src: plate, width: 1600, format: 'webp' });

/* The people, placed as the camera places them: the plate cover-fits the
   mark's box ("slice"), and each cutout is a fraction of the plate. */
const cuts = import.meta.glob<{ default: ImageMetadata }>('../assets/img/hero/*.png', {
  eager: true,
});
const k = Math.max(BIRD_W / PLATE.w, BIRD_H / PLATE.h);
const pw = PLATE.w * k;
const ph = PLATE.h * k;
const px0 = (BIRD_W - pw) / 2;
const py0 = (BIRD_H - ph) / 2;
const people = await Promise.all(
  BEATS.filter((b) => b.cut).map(async (b) => {
    const src = cuts[`../assets/img/hero/${b.id}.png`].default;
    const im = await getImage({ src, width: 400, format: 'webp' });
    const w = b.cut!.w * pw;
    return {
      id: b.id,
      href: im.src,
      x: px0 + b.cut!.x * pw,
      y: py0 + b.cut!.y * ph,
      w,
      h: (w * src.height) / src.width,
    };
  }),
);
/* The cast, as the live overlay rests (spec, revised 2026-09-22). This
   poster IS the resting state under `prefers-reduced-motion` and without
   JS, and the resting state now contains the three people — so it carries
   them too, or the fallback would show a different composition from the
   one the animation settles into (CLAUDE.md: the fallback is the resting
   state, coherent and readable).

   The viewBox is already bird-box units, so the geometry needs no
   transform here — the one place this is simpler than the live overlay.
   Images are reused from above: same plate, same cutouts, no extra
   variants for the fallback path. */
const cast = castWindows({
  amena: cuts['../assets/img/hero/amena.png'].default,
  faysal: cuts['../assets/img/hero/faysal.png'].default,
  rahim: cuts['../assets/img/hero/rahim.png'].default,
});
const figHref = Object.fromEntries(people.map((p) => [p.id, p.href]));
---

<section class="bird-still" aria-label="The bKash mark, framing the street">
  <svg
    class="bird-still__mark"
    viewBox={`0 0 ${BIRD_W} ${BIRD_H}`}
    role="img"
    aria-label="The bKash bird, with the neighbourhood street inside it"
  >
    <defs>
      <clipPath id="bird-still-clip">
        {paths.map((d) => (
          <path d={d}></path>
        ))}
      </clipPath>
      {cast.map((c) => (
        <clipPath id={`still-${c.clipId}`}>
          <path d={facetPath(c.facet)}></path>
        </clipPath>
      ))}
    </defs>
    <g clip-path="url(#bird-still-clip)">
      <image
        href={img.src}
        width={BIRD_W}
        height={BIRD_H}
        preserveAspectRatio="xMidYMid slice"
      />
      {people.map((p) => (
        <image href={p.href} x={p.x} y={p.y} width={p.w} height={p.h} data-cut={p.id} />
      ))}
    </g>
    {cast.map((c) => (
      <g clip-path={`url(#still-${c.clipId})`}>
        <image href={img.src} x={c.bg.x} y={c.bg.y} width={c.bg.w} height={c.bg.h} />
        <image href={figHref[c.id]} x={c.fig.x} y={c.fig.y} width={c.fig.w} height={c.fig.h} />
      </g>
    ))}
    <g class="bird-still__lines" fill="none">
      {paths.map((d) => (
        <path d={d} vector-effect="non-scaling-stroke"></path>
      ))}
    </g>
  </svg>
  <div class="bird-still__copy">
    <h2 class="t-h1 bird-still__title">A financial ecosystem</h2>
    <p class="t-lead bird-still__line">Reaching every corner</p>
  </div>
</section>

<style>
  .bird-still {
    display: none;
    padding: var(--s-9) var(--gutter);
    background: var(--paper);
    text-align: center;
  }

  :global(.no-js) .bird-still {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .bird-still {
      display: block;
    }
  }

  .bird-still__mark {
    display: block;
    margin-inline: auto;
    height: calc(var(--vh) * 0.58);
    width: auto;
  }

  .bird-still__lines path {
    stroke: var(--paper);
    stroke-width: 2;
  }

  .bird-still__copy {
    margin-top: var(--s-6);
    color: var(--ink);
  }

  /* The auto margins are the centring, not text-align. The block is
     text-align: center gutter to gutter, but each child centres its text
     inside its OWN box — and .t-lead carries max-width: --measure-tight
     (46ch), so without these the line box sat flush against the left
     gutter and its text centred on that box rather than on the section.
     The title has carried them all along, which is why the two disagreed.

     Only visible on the wide composition: below 767px the column is
     already narrower than 46ch, so the margins resolve to 0 and nothing
     moves. Nahian, 2026-09-22. */
  .bird-still__line {
    color: var(--ink-2);
    margin-top: var(--s-4);
    margin-inline: auto;
  }

  .bird-still__title {
    margin-inline: auto;
  }

  @media (max-width: 767px) {
    .bird-still__mark {
      height: auto;
      width: 86%;
    }
  }
</style>
