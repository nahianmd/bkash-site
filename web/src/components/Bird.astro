---
/* The bird's still — shown ONLY without JS or under reduced motion.
   The live bird is BirdOverlay.astro inside the hero's pin; this is
   the same poster with no machinery: the plate, clipped to the mark,
   sized by CSS, copy beneath. */
import { getImage } from 'astro:assets';
import plate from '../assets/img/hero/plate.jpeg';
import { FACETS, facetPath, BIRD_W, BIRD_H } from '../lib/bird-shape';
import { BEATS, PLATE } from '../lib/hero-beats';

const paths = FACETS.map((_, i) => facetPath(i));
const img = await getImage({ src: plate, width: 1600, format: 'webp' });

/* The people, placed as the camera places them: the plate cover-fits the
   mark's box ("slice"), and each cutout is a fraction of the plate. */
const cuts = import.meta.glob<{ default: ImageMetadata }>('../assets/img/hero/*.png', {
  eager: true,
});
const k = Math.max(BIRD_W / PLATE.w, BIRD_H / PLATE.h);
const pw = PLATE.w * k;
const ph = PLATE.h * k;
const px0 = (BIRD_W - pw) / 2;
const py0 = (BIRD_H - ph) / 2;
const people = await Promise.all(
  BEATS.filter((b) => b.cut).map(async (b) => {
    const src = cuts[`../assets/img/hero/${b.id}.png`].default;
    const im = await getImage({ src, width: 400, format: 'webp' });
    const w = b.cut!.w * pw;
    return {
      id: b.id,
      href: im.src,
      x: px0 + b.cut!.x * pw,
      y: py0 + b.cut!.y * ph,
      w,
      h: (w * src.height) / src.width,
    };
  }),
);
---

<section class="bird-still" aria-label="The bKash mark, framing the street">
  <svg
    class="bird-still__mark"
    viewBox={`0 0 ${BIRD_W} ${BIRD_H}`}
    role="img"
    aria-label="The bKash bird, with the neighbourhood street inside it"
  >
    <defs>
      <clipPath id="bird-still-clip">
        {paths.map((d) => (
          <path d={d}></path>
        ))}
      </clipPath>
    </defs>
    <g clip-path="url(#bird-still-clip)">
      <image href={img.src} width={BIRD_W} height={BIRD_H} preserveAspectRatio="xMidYMid slice" />
      {people.map((p) => (
        <image href={p.href} x={p.x} y={p.y} width={p.w} height={p.h} data-cut={p.id} />
      ))}
    </g>
    <g class="bird-still__lines" fill="none">
      {paths.map((d) => (
        <path d={d} vector-effect="non-scaling-stroke"></path>
      ))}
    </g>
  </svg>
  <div class="bird-still__copy">
    <p class="t-eyebrow bird-still__eyebrow">Across Bangladesh</p>
    <h2 class="t-h1 bird-still__title">Writing Millions of Stories in Motion</h2>
  </div>
</section>

<style>
  .bird-still {
    display: none;
    padding: var(--s-9) var(--gutter);
    background: var(--paper);
    text-align: center;
  }

  :global(.no-js) .bird-still {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .bird-still {
      display: block;
    }
  }

  .bird-still__mark {
    display: block;
    margin-inline: auto;
    height: calc(var(--vh) * 0.58);
    width: auto;
  }

  .bird-still__lines path {
    stroke: var(--paper);
    stroke-width: 2;
  }

  .bird-still__copy {
    margin-top: var(--s-6);
    color: var(--ink);
  }

  .bird-still__eyebrow {
    color: var(--ink-3);
    margin-bottom: var(--s-4);
  }

  .bird-still__title {
    margin-inline: auto;
  }

  @media (max-width: 767px) {
    .bird-still__mark {
      height: auto;
      width: 86%;
    }
  }
</style>
