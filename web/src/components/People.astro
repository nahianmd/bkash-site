---
/* Section 3: People — three of the 85 million.
   specs/sections/people.md

   The hero showed three TYPES in a rendered street; this shows three
   NAMED people in real photographs — the page's turn from story to
   proof (Rule 1). Three portrait cards of equal size at one 4:5 crop,
   one caption block on one scrim (Rule 3), the hovered or tapped one
   full while the others recede (Rule 4). No card changes size — the
   prototype's hover-expand row is exactly what this is not. */
import { Picture } from 'astro:assets';

const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/img/people/*.jpg', {
  eager: true,
});
const portrait = (id: string) => portraits[`../assets/img/people/${id}.jpg`].default;

/* Names and roles are the reference project's — real people. Clearance
   for public use is a client question (spec). Crops are per photograph:
   faces in the upper third. */
const PEOPLE = [
  { id: 'anisul', tag: 'Customer', name: 'Anisul Haque', role: 'CNG driver', cta: 'Know his story', pos: '50% 30%' },
  { id: 'munni', tag: 'Agent', name: 'Munni Barua', role: 'Known as “bKash Didi”', cta: 'Know her story', pos: '50% 40%' },
  { id: 'shajib', tag: 'Merchant', name: 'Shajib Ahmed', role: 'Book shop owner', cta: 'Know his story', pos: '50% 30%' },
];
const posCss = PEOPLE.map((p) => `.people__card[data-people-card="${p.id}"] img{object-position:${p.pos}}`).join('');
---

<section class="people" data-people aria-label="Three of the 85 million">
  <div class="wrap people__in">
    <div class="people__head">
      <p class="t-eyebrow people__eyebrow">Meet three of them</p>
      <h2 class="t-h1 people__title">Real streets. Real stories.</h2>
    </div>

    <div class="people__cards" data-people-cards>
      {PEOPLE.map((p) => (
        <article class="people__card" data-people-card={p.id} tabindex="0">
          <Picture
            src={portrait(p.id)}
            alt={`${p.name}, ${p.role}`}
            widths={[480, 720, 960, 1500]}
            sizes="(max-width: 767px) 100vw, 33vw"
            formats={['avif', 'webp']}
            layout="none"
            loading="lazy"
            pictureAttributes={{ class: 'people__pic' }}
          />
          <div class="people__cap on-photo" data-people-caps>
            <p class="t-eyebrow people__tag">{p.tag}</p>
            <p class="t-h3 people__name">{p.name}</p>
            <p class="t-sm people__role">{p.role}</p>
            <a class="btn btn--outline people__cta" href="#">{p.cta} →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global set:html={posCss}></style>

<style>
  /* The turn: the bird rests on white; this ground is the warm dark. */
  .people {
    background: var(--night-2);
    color: var(--on-night);
    padding-block: var(--s-10);
  }
  .people__head {
    max-width: var(--measure-head);
    margin-bottom: var(--s-8);
  }
  .people__eyebrow {
    color: var(--pink-lift);
    margin-bottom: var(--s-4);
  }

  /* Three objects on a field: inside the gutter, equal, one crop. */
  .people__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
    will-change: transform;
  }
  .people__card {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--night);
    cursor: pointer;
    transition:
      opacity var(--recede-t) var(--ease-io),
      filter var(--recede-t) var(--ease-io);
  }
  .people__card:focus-visible {
    outline: 2px solid var(--pink);
    outline-offset: 3px;
  }
  .people :global(.people__pic),
  .people :global(.people__pic img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* One caption block, one scrim (Rule 3), bottom-left of every card. */
  .people__cap {
    position: absolute;
    left: var(--s-6);
    right: var(--s-6);
    bottom: var(--s-6);
    will-change: transform;
  }
  .people__tag {
    color: var(--pink-lift);
    margin-bottom: var(--s-3);
  }
  .people__role {
    color: var(--on-night-2);
    margin-top: var(--s-1);
  }
  .people__cta {
    margin-top: var(--s-4);
    color: var(--on-night);
  }

  /* Focus (Rule 4): the pointed-at card is full, the other two recede by
     the token set. Hover is CSS; tap and keyboard set .is-on / .is-picked
     from people.ts. No card changes size. */
  .people__cards:has(.people__card:hover) .people__card:not(:hover),
  .people.is-picked .people__card:not(.is-on) {
    opacity: var(--recede-opacity);
    filter: saturate(var(--recede-saturate)) brightness(var(--recede-brightness));
  }

  /* 390: the three stacked, full width, the same crop and caption. */
  @media (max-width: 767px) {
    .people {
      padding-block: var(--s-9);
    }
    .people__cards {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
    .people__cap {
      left: var(--s-5);
      right: var(--s-5);
      bottom: var(--s-5);
    }
  }
</style>

<script>
  import { initPeople } from '../lib/people';
  initPeople();
</script>
