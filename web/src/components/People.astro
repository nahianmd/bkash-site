---
/* Section 3: People — three of the 85 million.
   specs/sections/people.md

   The hero showed three TYPES in a rendered street; this shows three
   NAMED people in real photographs — the page's turn from story to
   proof (Rule 1). Three portrait cards of equal size at one 4:5 crop,
   one caption block on one scrim (Rule 3), the hovered or tapped one
   full while the others recede (Rule 4). On desktop the row behaves as
   the prototype's did (Nahian, 2026-09-20): the pointed-at card takes
   three shares of the row, its neighbours drop to just over a half
   share and shed everything but a small name; the row always sums to
   the same width. On a phone the three are stacked edge to edge and
   the same expand runs vertically on tap (Nahian, 2026-09-23). */
import { Picture } from 'astro:assets';

const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/img/people/*.jpg', {
  eager: true,
});
const portrait = (id: string) => portraits[`../assets/img/people/${id}.jpg`].default;

/* Names and roles are the reference project's — real people. Clearance
   for public use is a client question (spec). Crops are per photograph:
   faces in the upper third. */
const PEOPLE = [
  {
    id: 'anisul',
    tag: 'Customer',
    name: 'Anisul Haque',
    role: 'CNG driver',
    cta: 'Know his story',
    pos: '50% 30%',
  },
  {
    id: 'munni',
    tag: 'Agent',
    name: 'Munni Barua',
    role: 'Known as “bKash Didi”',
    cta: 'Know her story',
    pos: '50% 40%',
  },
  {
    id: 'shajib',
    tag: 'Merchant',
    name: 'Shajib Ahmed',
    role: 'Book shop owner',
    cta: 'Know his story',
    pos: '50% 30%',
  },
];
const posCss = PEOPLE.map(
  (p) => `.people__card[data-people-card="${p.id}"] img{object-position:${p.pos}}`,
).join('');
---

<section class="people" data-people aria-label="Three of the 85 million">
  <!-- The head keeps the page wrap — gutter and --page — so this heading
       stays in line with every other section's. The cards deliberately do
       not: they are a SIBLING of the wrap rather than a child, which is
       what lets them run the full width without a negative-margin trick,
       and without a 100vw that would overshoot by the scrollbar.
       Nahian, 2026-09-22. -->
  <div class="wrap people__in">
    <div class="people__head" data-people-head>
      <p class="t-eyebrow people__eyebrow">Meet three of them</p>
      <h2 class="t-h1 people__title">Stories behind the numbers</h2>
    </div>
  </div>

  <div class="people__cards" data-people-cards>
    {PEOPLE.map((p) => (
      <article class="people__card" data-people-card={p.id} tabindex="0">
        <Picture
          src={portrait(p.id)}
          alt={`${p.name}, ${p.role}`}
          widths={[480, 720, 960, 1500]}
          sizes="(max-width: 767px) 100vw, 33vw"
          formats={['avif', 'webp']}
          layout="none"
          loading="lazy"
          pictureAttributes={{ class: 'people__pic' }}
        />
        <div class="people__cap on-photo" data-people-caps>
          <p class="t-eyebrow people__tag">{p.tag}</p>
          <p class="t-h3 people__name">{p.name}</p>
          <p class="t-sm people__role">{p.role}</p>
          <div class="people__cta-wrap">
            <a class="btn btn--outline people__cta" href="#">
              {p.cta} →
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style is:global set:html={posCss}></style>

<style>
  /* The turn: the bird rests on white; this ground is the warm dark. */
  .people {
    background: var(--night-2);
    color: var(--on-night);
    /* No foot: the cards end the section, flush against the next one
       (Nahian, 2026-09-23). */
    padding-top: var(--s-10);
  }
  .people__head {
    margin-bottom: var(--s-8);
    will-change: transform;
  }
  /* The title on one line; the measure is the frame's. */
  .people__title {
    max-width: none;
  }
  .people__eyebrow {
    color: var(--pink-lift);
    margin-bottom: var(--s-4);
  }

  /* Three objects on a field: edge to edge, one row, one crop. Each
     card is a flex share; the whole expansion is the share.

     Full-bleed on the wide composition (Nahian, 2026-09-22): the row
     used to sit inside the wrap, so on a 1920 screen it stopped 288px
     short of each edge on --page alone, before the gutter. It is a
     sibling of the wrap now, so the width is simply the section's.
     The phone is full-bleed too — see the 767 block. */
  /* No gap and no radius (Nahian, 2026-09-24): the three meet edge to
     edge and run square to the section's boundaries, as on a phone. */
  .people__cards {
    display: flex;
    gap: 0;
    height: min(calc(var(--vh) * 0.62), 40rem);
  }
  .people__card {
    position: relative;
    flex: 1 1 0%;
    min-width: 0;
    overflow: hidden;
    background: var(--night);
    cursor: pointer;
    transition:
      flex var(--t-slow) var(--ease),
      opacity var(--recede-t) var(--ease-io),
      filter var(--recede-t) var(--ease-io);
  }
  /* The picked card takes three shares; the neighbours just over a
     half. Written at the same depth as the collapse so the open rule
     wins on order, not specificity. Tap and keyboard set .is-picked /
     .is-on from people.ts; mouse hover mirrors all of this in the
     (hover: hover) block below. */
  .people.is-picked .people__card {
    flex: 0.55 1 0%;
  }
  .people.is-picked .people__card.is-on {
    flex: 3 1 0%;
  }
  /* inside the card: with no gap, an outside ring would sit on the
     neighbour or off the screen's edge */
  .people__card:focus-visible {
    outline: 2px solid var(--pink);
    outline-offset: -2px;
  }
  .people :global(.people__pic),
  .people :global(.people__pic img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .people :global(.people__pic img) {
    transition: transform var(--t-veil) var(--ease);
  }
  .people__card.is-on :global(.people__pic img) {
    transform: scale(1.04);
  }

  /* One caption block, one scrim (Rule 3), bottom-left of every card. */
  .people__cap {
    position: absolute;
    left: var(--s-6);
    right: var(--s-6);
    bottom: var(--s-6);
    will-change: transform;
  }
  .people__tag {
    color: var(--pink-lift);
    margin-bottom: var(--s-3);
    max-height: 2rem;
    overflow: hidden;
    transition:
      opacity var(--t-base) var(--ease-io),
      max-height var(--t-base) var(--ease-io),
      margin var(--t-base) var(--ease-io);
  }
  .people__name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition:
      font-size var(--t-base) var(--ease-io),
      opacity var(--t-base) var(--ease-io);
  }
  .people__role {
    color: var(--on-night-2);
    margin-top: var(--s-1);
    max-height: 2.5rem;
    overflow: hidden;
    transition:
      opacity var(--t-base) var(--ease-io),
      max-height var(--t-base) var(--ease-io);
  }
  /* The CTA appears only on the open card. */
  .people__cta-wrap {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height var(--t-slow) var(--ease),
      opacity var(--t-base) var(--ease-io);
  }
  .people__card.is-on .people__cta-wrap {
    max-height: 5rem;
    opacity: 1;
  }
  .people__cta {
    margin-top: var(--s-4);
    color: var(--on-night);
  }
  /* Collapsed neighbours shed everything but a smaller, dimmer name. */
  .people.is-picked .people__card:not(.is-on) .people__tag {
    opacity: 0;
    max-height: 0;
    margin-bottom: 0;
  }
  .people.is-picked .people__card:not(.is-on) .people__name {
    font-size: var(--fs-body);
    opacity: 0.65;
  }
  .people.is-picked .people__card:not(.is-on) .people__role {
    opacity: 0;
    max-height: 0;
  }

  /* Focus (Rule 4): the picked card is full, the other two recede by
     the token set as well as shrinking. */
  .people.is-picked .people__card:not(.is-on) {
    opacity: var(--recede-opacity);
    filter: saturate(var(--recede-saturate)) brightness(var(--recede-brightness));
  }

  /* Hover is the same state, driven by the pointer — and only where a
     real pointer hovers. A phone leaves :hover stuck on the last card
     tapped, which would hold it open after a second tap closed it.
     Last in the sheet, so a hovered card wins over a picked one. */
  @media (hover: hover) {
    .people__cards:has(.people__card:hover) .people__card {
      flex: 0.55 1 0%;
    }
    .people__cards:has(.people__card:hover) .people__card:hover {
      flex: 3 1 0%;
    }
    .people__card:hover :global(.people__pic img) {
      transform: scale(1.04);
    }
    .people__card:hover .people__cta-wrap {
      max-height: 5rem;
      opacity: 1;
    }
    .people__cards:has(.people__card:hover) .people__card:not(:hover) .people__tag {
      opacity: 0;
      max-height: 0;
      margin-bottom: 0;
    }
    .people__cards:has(.people__card:hover) .people__card:not(:hover) .people__name {
      font-size: var(--fs-body);
      opacity: 0.65;
    }
    .people__cards:has(.people__card:hover) .people__card:not(:hover) .people__role {
      opacity: 0;
      max-height: 0;
    }
    .people__cards:has(.people__card:hover) .people__card:not(:hover) {
      opacity: var(--recede-opacity);
      filter: saturate(var(--recede-saturate)) brightness(var(--recede-brightness));
    }
  }

  /* 390: the three stacked edge to edge — no gutter, no gap, no radius
     (Nahian, 2026-09-23). The expand is the desktop row turned on its
     side: the column has a fixed height and the cards are flex shares
     of it, so a tap trades height between the three and nothing below
     the section moves. At rest each card is a square of the width,
     capped so the open card stays inside one screen. */
  @media (max-width: 767px) {
    .people {
      padding-top: var(--section-pad-phone);
      container-type: inline-size;
    }
    .people__cards {
      flex-direction: column;
      gap: 0;
      height: calc(3 * min(100cqi, var(--vh) * 0.55));
    }
    .people__card {
      border-radius: 0;
    }
    .people.is-picked .people__card {
      flex: 0.65 1 0%;
    }
    .people.is-picked .people__card.is-on {
      flex: 1.7 1 0%;
    }
    /* A narrow desktop window: the same shares under a mouse. */
    @media (hover: hover) {
      .people__cards:has(.people__card:hover) .people__card {
        flex: 0.65 1 0%;
      }
      .people__cards:has(.people__card:hover) .people__card:hover {
        flex: 1.7 1 0%;
      }
    }
    .people__card:focus-visible {
      outline-offset: -2px;
    }
    .people__cap {
      left: var(--s-5);
      right: var(--s-5);
      bottom: var(--s-5);
    }
  }
</style>

<script>
  import { initPeople } from '../lib/people';
  initPeople();
</script>
