---
/* Section 4: A thousand more stories → the phone.
   specs/sections/services.md · specs/services/plan.md

   Two walls are rendered — four columns and two — and CSS shows one
   per breakpoint, so each is composed for its width rather than
   reflowed from the other. The phone stands up out of the photographed
   hand as an object, slides beside the copy and stays alive. The
   sixteen services are ServicesDetail.astro, reached by the button. */
import { Picture, getImage } from 'astro:assets';
import { COLUMNS, type WallTile } from '../lib/services';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/img/services/*.jpg', {
  eager: true,
});
const photo = (name: string) => photos[`../assets/img/services/${name}.jpg`].default;
import screen from '../assets/img/services/screen.jpg';
import phonePhoto from '../assets/img/services/phone.jpg';
import phoneModel from '../assets/models/phone.glb?url';
/* The screenshot as the WebGL display's texture: the same file the CSS
   device shows, at its own size. */
const screenTex = await getImage({ src: screen, width: 720, format: 'jpeg' });

/* Crops are data, and the gate forbids inline styles — so the
   object-position rules are generated here, one class per photograph
   and crop, and emitted as a stylesheet. */
const posRules = new Map<string, string>();
for (const cols of [COLUMNS.desktop, COLUMNS.phone])
  for (const col of cols)
    for (const t of col)
      if (t.kind === 'photo') posRules.set(`pos-${t.photo}-${t.crop}`, t.pos);
const posCss = [...posRules]
  .map(([cls, pos]) => `.${cls} img{object-position:${pos}}`)
  .join('');

const walls: { key: 'desktop' | 'phone'; cols: WallTile[][] }[] = [
  { key: 'desktop', cols: COLUMNS.desktop },
  { key: 'phone', cols: COLUMNS.phone },
];
---

<section
  class="svc"
  data-services
  aria-label="A thousand more stories, and the bKash app"
>
  <div class="svc__pin" data-services-pin>
    {walls.map(({ key, cols }) => (
      <div class={`wall wall--${key}`} data-wall={key}>
        {cols.map((tiles, ci) => (
          <div class="wall__col" data-wall-col={ci}>
            {tiles.map((t) =>
              t.kind === 'photo' ? (
                <figure
                  class={`tile tile--${t.crop} pos-${t.photo}-${t.crop}`}
                  data-tile="photo"
                >
                  <Picture
                    src={photo(t.photo)}
                    alt=""
                    widths={[400, 640, 960]}
                    sizes={key === 'desktop' ? '25vw' : '50vw'}
                    formats={['avif', 'webp']}
                    layout="none"
                    loading="lazy"
                  />
                </figure>
              ) : t.kind === 'title' ? (
                <div class="tile tile--title" data-tile="title">
                  <p class="t-eyebrow tile__eyebrow">And</p>
                  <h2 class="t-h2 tile__title">A thousand more stories</h2>
                  <p class="t-sm tile__line">85 million of them, actually.</p>
                </div>
              ) : (
                <div class="tile tile--phone" data-tile="phone">
                  <Picture
                    src={phonePhoto}
                    alt="A hand holding a phone with the bKash home screen open"
                    widths={[480, 960, 1440]}
                    sizes={key === 'desktop' ? '25vw' : '50vw'}
                    formats={['avif', 'webp']}
                    layout="none"
                    loading="lazy"
                  />
                </div>
              ),
            )}
          </div>
        ))}
      </div>
    ))}

    <!-- The phone as an object: a WebGL canvas over the pin, one handset
         mesh, posed by services.ts over the photographed screen; it fades
         in over the photograph, stands up and comes forward to Rest B while
         the wall tips back. Loaded as the section approaches. -->
    <canvas
      class="device3d"
      data-device-3d
      data-model={phoneModel}
      data-screen={screenTex.src}
      aria-hidden="true"></canvas>
    <!-- The CSS device: the same handset's proportions (body, display,
         corners, island — services.ts writes them from device.ts), sized
         to Rest B. It takes over from the object for the zoom into the
         grid, and does the whole emergence itself where WebGL is not
         available. -->
    <div class="device" data-device aria-hidden="true">
      <div class="device__screen" data-device-screen>
        <Picture
          src={screen}
          alt=""
          widths={[360, 720]}
          sizes="30vw"
          formats={['avif', 'webp']}
          layout="none"
          loading="lazy"
        />
      </div>
      <div class="device__island"></div>
    </div>
    <!-- The ground turns white as the phone lifts out of the wall. -->
    <div class="ground" data-ground></div>

    <!-- The copy the phone slides beside: left column on desktop, the foot
         of the frame on a phone. PLACEHOLDER until the client's. -->
    <div class="svc__copy" data-copy>
      <p class="t-eyebrow svc__eyebrow">Sixteen services</p>
      <h2 class="t-h2 svc__title">Everything money does, in one app.</h2>
      <p class="t-lead svc__line">
        Send, pay, save, borrow, insure. Sixteen services, one bKash account, in the phone
        already in your hand.
      </p>
      <a class="btn btn--primary svc__cta" href="#services-detail">See details of our services</a>
    </div>

  </div>

</section>

<style is:global set:html={posCss}></style>

<style>
  .svc {
    position: relative;
    /* One screen of pin plus the travel (config: travelScreens). */
    height: calc(var(--vh) * var(--svc-screens, 6.5));
    background: var(--paper);
    /* How far copy and phone are gathered toward each other at rest on
       desktop — the copy from its gutter, the phone from its column's
       centre. One token, read by the CSS below and by services.ts. */
    --svc-gather: var(--s-8);
  }

  .svc__pin {
    position: relative;
    height: var(--vh);
    overflow: hidden;
    background: var(--paper);
    perspective: 1500px;
    perspective-origin: 50% 42%;
  }

  /* ---- the wall: full viewport width, not the container ---- */
  .wall {
    position: absolute;
    inset: 0;
    display: grid;
    gap: var(--s-4);
    padding-inline: var(--s-4);
    align-items: start;
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }
  .wall--desktop {
    grid-template-columns: repeat(4, 1fr);
  }
  .wall--phone {
    grid-template-columns: repeat(2, 1fr);
    display: none;
  }
  @media (max-width: 767px) {
    .wall--desktop {
      display: none;
    }
    .wall--phone {
      display: grid;
    }
  }

  .wall__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
    will-change: transform;
  }

  .tile {
    position: relative;
    width: 100%;
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--paper-2);
  }
  .tile--tall {
    aspect-ratio: 4 / 5;
  }
  .tile--square {
    aspect-ratio: 1;
  }
  .tile--wide {
    aspect-ratio: 3 / 2;
  }
  .tile :global(picture),
  .tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The one typographic tile. Night on the paper. */
  .tile--title {
    aspect-ratio: 1;
    background: var(--night-2);
    color: var(--paper);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--s-5);
  }
  .tile__eyebrow {
    color: var(--pink);
    margin-bottom: var(--s-3);
  }
  .tile__line {
    color: var(--on-night-2);
    margin-top: var(--s-3);
  }

  /* ---- the device ------------------------------------------------ */
  .device3d {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    z-index: 5;
  }
  .device {
    position: absolute;
    /* Size, position, radius and the display's inset are written by
       services.ts once per resize from the handset's proportions; only
       the transform changes per frame. */
    left: 0;
    top: 0;
    width: 100px;
    height: 211px;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--device-body);
    transform-origin: 50% 50%;
    will-change: transform, opacity;
    opacity: 0;
    z-index: 5;
  }
  .device__screen {
    position: absolute;
    inset: var(--screen-inset-y, 4px) var(--screen-inset-x, 4px);
    border-radius: var(--screen-r, var(--r-md));
    overflow: hidden;
    background: var(--paper);
  }
  .device__screen :global(picture),
  .device__screen :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }
  .device__island {
    position: absolute;
    top: var(--island-top, 4%);
    left: 50%;
    width: var(--island-w, 28%);
    height: var(--island-h, 2.5%);
    transform: translateX(-50%);
    border-radius: var(--r-full);
    background: var(--device-island);
  }

  /* ---- the ground and the grid ------------------------------------ */
  .ground {
    position: absolute;
    inset: 0;
    background: var(--paper);
    opacity: 0;
    z-index: 3;
    pointer-events: none;
  }

  /* The phone tile: the photograph of a hand holding the phone, at the
     photograph's own aspect and uncropped, so PHONE_QUAD's fractions are
     the tile's. Indistinguishable from the other tiles at rest. */
  .tile--phone {
    aspect-ratio: 3 / 4;
  }

  /* ---- the copy beside the phone ---------------------------------- */
  .svc__copy {
    position: absolute;
    left: calc(var(--gutter) + var(--svc-gather));
    right: calc(50% + var(--s-6) / 2);
    top: var(--nav-h);
    bottom: 0;
    z-index: 6;
    display: grid;
    align-content: center;
    gap: var(--s-4);
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
  }
  .svc__copy.is-on {
    pointer-events: auto;
  }
  .svc__eyebrow {
    color: var(--pink);
  }
  .svc__line {
    color: var(--ink-2);
  }
  .svc__cta {
    justify-self: start;
    margin-top: var(--s-3);
  }
  @media (max-width: 767px) {
    .svc__copy {
      left: var(--gutter);
      right: var(--gutter);
      top: auto;
      bottom: var(--gutter);
      align-content: end;
      gap: var(--s-3);
    }
    .svc__title {
      font-size: var(--fs-h3);
      line-height: 1.15;
    }
    .svc__line {
      font-size: var(--fs-body);
      line-height: 1.45;
    }
  }

  /* ---- no JS / reduced motion: everything in flow, everything usable ---- */
  :global(.no-js) .svc,
  .svc.svc--static {
    height: auto;
  }
  :global(.no-js) .svc__pin,
  .svc--static .svc__pin {
    height: auto;
    overflow: visible;
    perspective: none;
  }
  :global(.no-js) .wall,
  .svc--static .wall {
    position: relative;
    height: var(--vh);
    overflow: hidden;
  }
  :global(.no-js) .device,
  :global(.no-js) .device3d,
  :global(.no-js) .ground,
  .svc--static .device,
  .svc--static .device3d,
  .svc--static .ground {
    display: none;
  }
  :global(.no-js) .svc__copy,
  .svc--static .svc__copy {
    position: relative;
    inset: auto;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    background: var(--paper);
    padding: var(--s-8) var(--gutter);
  }
</style>

<script>
  import { initServices } from '../lib/services';
  initServices();
</script>
