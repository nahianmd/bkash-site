---
/* Section 4: A thousand more stories → the phone.
   specs/sections/services.md · specs/services/plan.md

   The photographs fly in from the front, one by one in a random order
   as you scroll, into a collage that fills the pinned frame edge to
   edge, straight and square-cornered, overlapping unevenly (Nahian,
   2026-09-24; the Pinterest columns are gone). The
   phone photograph lands last, in the centre, and the screen stands up
   out of it, slides beside the copy and stays alive. The sixteen
   services are ServicesDetail.astro, reached by the button. */
import { Picture } from 'astro:assets';
import { MOSAIC, PHONE_POS, mosaicTiles, type MosaicTile } from '../lib/services';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/img/services/*.jpg', {
  eager: true,
});
const photo = (name: string) => photos[`../assets/img/services/${name}.jpg`].default;
import screen from '../assets/img/services/screen.jpg';
import phonePhoto from '../assets/img/services/phone.jpg';

/* Two collages — eleven by six, and six by eight for the phone — and CSS
   shows one per breakpoint, so each is composed for its width. The gate
   forbids inline styles, so each tile's place in its grid and each
   photograph's crop are generated here as classes and emitted as a
   stylesheet. */
const walls: { key: 'desktop' | 'phone'; tiles: MosaicTile[] }[] = [
  { key: 'desktop', tiles: mosaicTiles(MOSAIC.desktop) },
  { key: 'phone', tiles: mosaicTiles(MOSAIC.phone) },
];
/* The heading, word by word; the last is the one the intro zooms into. */
const HEADING = ['Writing', 'millions', 'of', 'stories', 'in', 'motion'];
const place = (key: string, t: MosaicTile) => `at-${key}-${t.order}`;
const posRules = new Map<string, string>();
const placeRules: string[] = [];
for (const { key, tiles } of walls)
  for (const t of tiles) {
    placeRules.push(`.${place(key, t)}{grid-area:${t.r}/${t.c}/span ${t.h}/span ${t.w}}`);
    /* each tile's own uneven run past its block; the phone photograph
       is sized to its whole 3:4 instead (below) */
    if (t.kind === 'photo')
      placeRules.push(
        `.wall>.${place(key, t)}>.tile{inset:${t.over.map((v) => `-${v}%`).join(' ')}}`,
      );
    if (t.kind === 'photo') posRules.set(`pos-${t.photo}`, t.pos);
  }
/* The phone photograph's crop anchor, from the one constant the
   emergence is solved through (lib/services.ts, PHONE_POS). */
posRules.set('tile--phone', `${PHONE_POS.x * 100}% ${PHONE_POS.y * 100}%`);
const posCss =
  placeRules.join('') +
  [...posRules].map(([cls, pos]) => `.${cls} img{object-position:${pos}}`).join('');
---

<section class="svc" data-services aria-label="Millions of stories, and the bKash app">
  <div class="svc__pin" data-services-pin>
    {/* The heading, which is also the intro: its words arrive one by one
        on the black, the view zooms into "Motion" and back out, and the
        line settles here (services.ts). One span per word. */}
    <div class="intro" data-intro>
      <h2 class="intro__line" data-intro-line>
        {HEADING.map((w, i) => (
          <>
            {i > 0 && ' '}
            <span
              class:list={['intro__word', { 'intro__word--key': i === HEADING.length - 1 }]}
              data-word
            >
              {w}
            </span>
          </>
        ))}
      </h2>
    </div>

    {/* The tiles in landing order, so a later tile paints over an earlier
        one where they overlap: the photographs in their shuffled order,
        then the phone. */}
    {walls.map(({ key, tiles }) => (
      <div class={`wall wall--${key}`} data-wall={key}>
        {tiles.map((t) => (
          <div class:list={['cell', place(key, t), { 'cell--phone': t.kind === 'phone' }]}>
            {t.kind === 'photo' ? (
              <figure class={`tile pos-${t.photo}`} data-tile="photo" data-order={t.order}>
                <Picture
                  src={photo(t.photo)}
                  alt=""
                  widths={[320, 480, 720]}
                  sizes={key === 'desktop' ? '18vw' : '36vw'}
                  formats={['avif', 'webp']}
                  layout="none"
                  loading="lazy"
                />
              </figure>
            ) : (
              <div class="tile tile--phone" data-tile="phone" data-order={t.order}>
                <Picture
                  src={phonePhoto}
                  alt="A hand holding a phone with the bKash home screen open"
                  widths={[480, 960]}
                  sizes={key === 'desktop' ? '25vw' : '55vw'}
                  formats={['avif', 'webp']}
                  layout="none"
                  loading="lazy"
                />
              </div>
            )}
          </div>
        ))}
      </div>
    ))}

    <!-- The screen as a slim slab, no handset (Nahian, 2026-09-24): the
         home screen in a light grey rim with a thin pink line, a few
         stepped layers behind for its edge. Posed by services.ts over the
         photographed screen; it fades in over the photograph, stands up
         out of the hand while the wall tips back, then turns and leans
         slightly as it slides beside the copy. Proportions and corners
         from device.ts. -->
    <div class="device" data-device aria-hidden="true">
      <div class="device__edge device__edge--3"></div>
      <div class="device__edge device__edge--2"></div>
      <div class="device__edge device__edge--1"></div>
      <div class="device__face">
        <div class="device__screen" data-device-screen>
          <Picture
            src={screen}
            alt=""
            widths={[360, 720]}
            sizes="30vw"
            formats={['avif', 'webp']}
            layout="none"
            loading="lazy"
          />
        </div>
      </div>
    </div>
    <!-- The ground turns white as the phone lifts out of the wall. -->
    <div class="ground" data-ground></div>

    <!-- The copy the phone slides beside: left column on desktop, the foot
         of the frame on a phone. PLACEHOLDER until the client's. -->
    <div class="svc__copy" data-copy>
      <p class="t-eyebrow svc__eyebrow">Sixteen services</p>
      <h2 class="t-h2 svc__title">Everything you need to manage your money</h2>
      <p class="t-lead svc__line">
        Send, receive, pay, save, borrow. All in one app, always within your reach.
      </p>
      <a class="btn btn--primary svc__cta" href="#services-detail">
        See details of our services
      </a>
      {/* On a phone the copy is the title and this link alone. */}
      <a class="svc__textlink t-sm" href="#services-detail">
        See details of our services →
      </a>
    </div>
  </div>
</section>

<style is:global set:html={posCss}></style>

<style>
  .svc {
    position: relative;
    /* One screen of pin plus the travel (config: travelScreens). */
    height: calc(var(--vh) * var(--svc-screens, 6.5));
    /* Black from its first pixel: arriving from the stories, the section
       opens on a black frame for the intro (Nahian, 2026-09-24). The
       ground below turns it white as the phone lifts out. */
    background: var(--night);
    /* How far copy and phone are gathered toward each other at rest on
             desktop — the copy from its gutter, the phone from its column's
             centre. One token, read by the CSS below and by services.ts. */
    --svc-gather: var(--s-8);
    /* The heading's band at the top of the frame, under the nav; the
       collage fills the frame below it. */
    --svc-head: clamp(5rem, 13vh, 7.5rem);
  }

  .svc__pin {
    position: relative;
    height: var(--vh);
    overflow: hidden;
    background: var(--night);
    perspective: 1500px;
    perspective-origin: 50% 42%;
  }

  /* ---- the heading, and the intro it plays ----------------------------
     At rest it is the section's heading in its band: white, "Motion" in
     pink, one line, centred. services.ts moves the whole line with one
     transform (origin top-left) and each word with its own, for the
     intro; with no JS, or reduced motion, it simply sits here. Above the
     collage, below the ground that whitens the frame. */
  .intro {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--nav-h);
    height: var(--svc-head);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--gutter);
    z-index: 2;
    pointer-events: none;
  }
  .intro__line {
    position: relative;
    margin: 0;
    white-space: nowrap;
    color: var(--paper);
    font-size: var(--fs-h2);
    line-height: 1.1;
    letter-spacing: -0.022em;
    font-weight: 700;
    transform-origin: 0 0;
  }
  /* No will-change on the line or its words, on purpose: it pins the
     text to the raster it was first drawn at, and a scaled line must be
     redrawn at each size to stay crisp. services.ts lays the line out at
     its largest and only ever scales it down. */
  .intro__word {
    display: inline-block;
  }
  .intro__word--key {
    color: var(--pink);
  }
  @media (max-width: 767px) {
    .svc {
      --svc-head: 4.5rem;
    }
    /* one line still, sized to the phone's width */
    .intro__line {
      font-size: min(var(--fs-h3), 4.6vw);
    }
  }

  /* ---- the wall: a collage filling the frame, edge to edge ---------
     From under the nav to the foot of the frame, no side margin
     (Nahian, 2026-09-24). Blocks of different sizes, no gap; each tile
     runs 4–9% past its block on each side, so neighbours overlap
     unevenly and a later tile sits on an earlier one. The grid's shape
     is MOSAIC's (lib/services.ts); each tile's place and overlap are
     generated classes. */
  .wall {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--nav-h) + var(--svc-head));
    bottom: 0;
    display: grid;
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }
  .wall--desktop {
    grid-template-columns: repeat(11, minmax(0, 1fr));
    grid-template-rows: repeat(6, minmax(0, 1fr));
  }
  .wall--phone {
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: repeat(8, minmax(0, 1fr));
    display: none;
  }
  @media (max-width: 767px) {
    .wall--desktop {
      display: none;
    }
    .wall--phone {
      display: grid;
    }
  }

  .cell {
    position: relative;
  }
  /* The photograph's own edge: square corners, no border, no shadow
     (Nahian, 2026-09-24). The overlap is the only thing that joins them. */
  .tile {
    position: absolute;
    inset: -6%;
    margin: 0;
    overflow: hidden;
    background: var(--paper-2);
    will-change: transform, opacity;
  }
  .tile :global(picture),
  .tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* A pink line along each edge (Nahian, 2026-09-24, after a reference):
     full pink through the middle of the edge, fading to nothing toward
     the corners. Four gradient layers on one overlay, drawn on the
     photograph's own edge, so it flies in with it and costs nothing
     per frame. 2px: 1px breaks up on a phone. */
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    --edge: var(--collage-edge);
    --run: transparent 0%, var(--pink) 35%, var(--pink) 65%, transparent 100%;
    background:
      linear-gradient(to right, var(--run)) top / 100% var(--edge) no-repeat,
      linear-gradient(to right, var(--run)) bottom / 100% var(--edge) no-repeat,
      linear-gradient(to bottom, var(--run)) left / var(--edge) 100% no-repeat,
      linear-gradient(to bottom, var(--run)) right / var(--edge) 100% no-repeat;
  }

  /* The phone photograph at its natural size (Nahian, 2026-09-24): the
     WHOLE photograph at its own 3:4, never cropped, and just big enough
     to cover its block — 8% past it on the tighter side, centred — so no
     white shows round it and it is no larger than it needs to be. Sized
     from the block (a size container). */
  .cell--phone {
    container-type: size;
  }
  .tile--phone {
    inset: auto;
    width: max(108cqw, 81cqh);
    height: max(144cqw, 108cqh);
    left: calc(50% - max(54cqw, 40.5cqh));
    top: calc(50% - max(72cqw, 54cqh));
  }


  /* ---- the device: the screen alone ------------------------------
     No handset (Nahian, 2026-09-24): the home screen, its corners
     rounded, a thin pink line around it — the width of the selected
     service's ring below (ServicesDetail.astro), 1px. Size, position and
     radius are written by services.ts once per resize from the
     display's proportions (device.ts); only the transform changes per
     frame. preserve-3d, not overflow:hidden, on the device itself, so
     the shadow can sit behind it in depth. */
  /* The frame, after "bKash Mobile.png" (Nahian, 2026-09-24): a white
     rim a few px wide around the screen and the 1px pink line round its
     outside. services.ts writes --rim and --screen-r; the rim's corners
     are the screen's plus the rim, so the curves stay parallel. */
  .device {
    position: absolute;
    left: 0;
    top: 0;
    width: 100px;
    height: 211px;
    border-radius: calc(var(--screen-r, var(--r-md)) + var(--rim, 8px));
    transform-origin: 50% 50%;
    transform-style: preserve-3d;
    will-change: transform, opacity;
    opacity: 0;
    z-index: 5;
  }
  /* The front of the slab: the white rim and its pink line, on a layer
     of its own — drawn on the 3D container itself, the line was lost
     once the edge layers sat behind it. The screen sits inside. */
  .device__face {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--device-rim);
    box-shadow: 0 0 0 1px var(--pink);
  }
  /* 2px on a phone (Nahian, 2026-09-24): at 1px the line, turned and
     rolled in 3D, broke up into a wavy stair-step there. Desktop keeps
     the service ring's 1px. */
  @media (max-width: 767px) {
    .device__face {
      box-shadow: 0 0 0 2px var(--pink);
    }
  }
  /* The shadow comes from the screen, not the outer line (Nahian,
     2026-09-24): the screen sits a hair proud of the rim and casts a
     mild shadow onto it, down and to the left, as if lit from the upper
     right. Static — it moves only with the parent's transform. */
  .device__screen {
    position: absolute;
    inset: var(--rim, 8px);
    border-radius: var(--screen-r, var(--r-md));
    overflow: hidden;
    background: var(--paper);
    box-shadow: calc(var(--rim, 8px) * -0.45) calc(var(--rim, 8px) * 0.3)
      calc(var(--rim, 8px) * 0.9) var(--device-shadow);
  }
  /* Thickness: three copies of the outline stepped back in depth. Face
     on they hide behind the front; turned, they show as a thin light
     edge down the left side — a slab, not a sheet, and no particular
     handset. */
  .device__edge {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--device-edge);
    box-shadow: 0 0 0 1px var(--pink-line);
  }
  .device__edge--1 {
    transform: translateZ(-2px);
  }
  .device__edge--2 {
    transform: translateZ(-4px);
  }
  .device__edge--3 {
    transform: translateZ(-6px);
  }
  .device__screen :global(picture),
  .device__screen :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  /* ---- the ground and the grid ------------------------------------ */
  .ground {
    position: absolute;
    inset: 0;
    background: var(--paper);
    opacity: 0;
    z-index: 3;
    pointer-events: none;
  }

  /* ---- the copy beside the phone ---------------------------------- */
  .svc__copy {
    position: absolute;
    left: calc(var(--gutter) + var(--svc-gather));
    right: calc(50% + var(--s-6) / 2);
    top: var(--nav-h);
    bottom: 0;
    z-index: 6;
    display: grid;
    align-content: center;
    gap: var(--s-4);
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
  }
  .svc__copy.is-on {
    pointer-events: auto;
  }
  .svc__eyebrow {
    color: var(--pink);
  }
  .svc__line {
    color: var(--ink-2);
  }
  .svc__cta {
    justify-self: start;
    margin-top: var(--s-3);
  }
  .svc__textlink {
    display: none;
    color: var(--pink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--pink-line);
  }
  .svc__textlink:hover {
    color: var(--pink-deep);
    text-decoration-color: currentColor;
  }
  /* Phone: the title and a text link, centred; the eyebrow, the line and
     the button are gone (Nahian, 2026-09-20). */
  @media (max-width: 767px) {
    .svc__copy {
      left: var(--gutter);
      right: var(--gutter);
      top: auto;
      /* clear of the fixed dock; services.ts solves the phone's
                     band from the same token */
      bottom: var(--search-space);
      align-content: end;
      justify-items: center;
      text-align: center;
      gap: var(--s-4);
    }
    .svc__eyebrow,
    .svc__line,
    .svc__cta {
      display: none;
    }
    .svc__textlink {
      display: inline-block;
    }
    .svc__title {
      font-size: var(--fs-h3);
      line-height: 1.15;
    }
    .svc__line {
      font-size: var(--fs-body);
      line-height: 1.45;
    }
  }

  /* ---- no JS / reduced motion: everything in flow, everything usable ---- */
  :global(.no-js) .svc,
  .svc.svc--static {
    height: auto;
  }
  :global(.no-js) .svc__pin,
  .svc--static .svc__pin {
    height: auto;
    overflow: visible;
    perspective: none;
  }
  /* The mosaic in flow, every tile landed (no transforms are ever
     written without JS; reduced motion renders the landed state). */
  :global(.no-js) .wall,
  .svc--static .wall {
    position: relative;
    top: auto;
    margin-top: calc(var(--nav-h) + var(--svc-head));
    height: calc(var(--vh) - var(--nav-h) - var(--svc-head));
    overflow: hidden;
  }
  :global(.no-js) .device,
  :global(.no-js) .ground,
  .svc--static .device,
  .svc--static .ground {
    display: none;
  }
  :global(.no-js) .svc__copy,
  .svc--static .svc__copy {
    position: relative;
    inset: auto;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    background: var(--paper);
    padding: var(--s-8) var(--gutter);
  }
</style>

<script>
  import { initServices } from '../lib/services';
  initServices();
</script>
