---
/* Section 4: A thousand more stories → the phone → sixteen services.
   specs/sections/services.md · specs/services/plan.md

   Task 1: the wall. Two walls are rendered — four columns and two —
   and CSS shows one per breakpoint, so each is composed for its width
   rather than reflowed from the other. The device, the grid and the
   card arrive in later tasks. */
import { Picture } from 'astro:assets';
import { COLUMNS, SERVICES, type WallTile } from '../lib/services';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/img/services/*.jpg', {
  eager: true,
});
const photo = (name: string) => photos[`../assets/img/services/${name}.jpg`].default;
import screen from '../assets/img/services/screen.jpg';
const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/icons/*.svg', {
  eager: true,
});
const icon = (id: string) => icons[`../assets/icons/${id}.svg`].default;

/* Crops are data, and the gate forbids inline styles — so the
   object-position rules are generated here, one class per photograph
   and crop, and emitted as a stylesheet. */
const posRules = new Map<string, string>();
for (const cols of [COLUMNS.desktop, COLUMNS.phone])
  for (const col of cols)
    for (const t of col)
      if (t.kind === 'photo') posRules.set(`pos-${t.photo}-${t.crop}`, t.pos);
const posCss = [...posRules]
  .map(([cls, pos]) => `.${cls} img{object-position:${pos}}`)
  .join('');

const walls: { key: 'desktop' | 'phone'; cols: WallTile[][] }[] = [
  { key: 'desktop', cols: COLUMNS.desktop },
  { key: 'phone', cols: COLUMNS.phone },
];
---

<section
  class="svc"
  data-services
  aria-label="A thousand more stories, and what a bKash account can do"
>
  <div class="svc__pin" data-services-pin>
    {walls.map(({ key, cols }) => (
      <div class={`wall wall--${key}`} data-wall={key}>
        {cols.map((tiles, ci) => (
          <div class="wall__col" data-wall-col={ci}>
            {tiles.map((t) =>
              t.kind === 'photo' ? (
                <figure
                  class={`tile tile--${t.crop} pos-${t.photo}-${t.crop}`}
                  data-tile="photo"
                >
                  <Picture
                    src={photo(t.photo)}
                    alt=""
                    widths={[400, 640, 960]}
                    sizes={key === 'desktop' ? '25vw' : '50vw'}
                    formats={['avif', 'webp']}
                    layout="none"
                    loading="lazy"
                  />
                </figure>
              ) : t.kind === 'title' ? (
                <div class="tile tile--title" data-tile="title">
                  <p class="t-eyebrow tile__eyebrow">And</p>
                  <h2 class="t-h2 tile__title">A thousand more stories</h2>
                  <p class="t-sm tile__line">85 million of them, actually.</p>
                </div>
              ) : (
                <div class="tile tile--phone" data-tile="phone">
                  <Picture
                    src={screen}
                    alt="The bKash app home screen"
                    widths={[360, 720]}
                    sizes="20vw"
                    formats={['avif', 'webp']}
                    layout="none"
                    loading="lazy"
                  />
                </div>
              ),
            )}
          </div>
        ))}
      </div>
    ))}

    <!-- The device. A sibling of the wall: at the end of the hold it is laid
         exactly over the phone tile (one transform: scale + translate about
         its centre), then grows into Rest B while the wall tips back. Bezel
         and notch are opacities. The grid and the card land in tasks 4–5. -->
    <div class="device" data-device aria-hidden="true">
      <div class="device__screen" data-device-screen>
        <Picture
          src={screen}
          alt=""
          widths={[360, 720]}
          sizes="30vw"
          formats={['avif', 'webp']}
          layout="none"
          loading="lazy"
        />
      </div>
      <div class="device__bezel" data-device-bezel></div>
      <div class="device__notch" data-device-notch></div>
    </div>
    <!-- The ground turns white as the screenshot gives way to the grid. -->
    <div class="ground" data-ground></div>

    <!-- The real grid. Sixteen cells in the app's order; each cell is
         centred on its icon so the lattice of icon centres matches the
         screenshot's, scaled — the zoom lands on it by construction. -->
    <div class="grid" data-grid>
      <div class="grid__in" data-grid-in role="list">
        {SERVICES.map((svc, i) => (
          <button
            class="cell"
            type="button"
            data-cell={i}
            role="listitem"
            aria-label={svc.name}
          >
            <span class="cell__icon">
              <img src={icon(svc.id).src} width="64" height="64" alt="" loading="lazy" />
            </span>
            <span class="cell__label t-sm">{svc.name}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Transparent nav over the dark wall; services.ts hides the marker
       once the ground has turned white. -->
  <div data-nav-dark-end data-svc-marker></div>
</section>

<style is:global set:html={posCss}></style>

<style>
  .svc {
    position: relative;
    /* One screen of pin plus the travel (config: travelScreens). */
    height: calc(var(--vh) * var(--svc-screens, 6.5));
    background: var(--night);
  }

  .svc__pin {
    position: relative;
    height: var(--vh);
    overflow: hidden;
    background: var(--night);
    perspective: 1500px;
    perspective-origin: 50% 42%;
  }

  /* ---- the wall: full viewport width, not the container ---- */
  .wall {
    position: absolute;
    inset: 0;
    display: grid;
    gap: var(--s-4);
    padding-inline: var(--s-4);
    align-items: start;
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }
  .wall--desktop {
    grid-template-columns: repeat(4, 1fr);
  }
  .wall--phone {
    grid-template-columns: repeat(2, 1fr);
    display: none;
  }
  @media (max-width: 767px) {
    .wall--desktop {
      display: none;
    }
    .wall--phone {
      display: grid;
    }
  }

  .wall__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
    will-change: transform;
  }

  .tile {
    position: relative;
    width: 100%;
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--night-2);
  }
  .tile--tall {
    aspect-ratio: 4 / 5;
  }
  .tile--square {
    aspect-ratio: 1;
  }
  .tile--wide {
    aspect-ratio: 3 / 2;
  }
  .tile :global(picture),
  .tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The one typographic tile. Paper on the dark. */
  .tile--title {
    aspect-ratio: 1;
    background: var(--paper);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--s-5);
  }
  .tile__eyebrow {
    color: var(--pink);
    margin-bottom: var(--s-3);
  }
  .tile__line {
    color: var(--ink-3);
    margin-top: var(--s-3);
  }

  /* ---- the device ------------------------------------------------ */
  .device {
    position: absolute;
    /* Size, position and radius are written by services.ts once per
               resize; only the transform changes per frame. */
    left: 0;
    top: 0;
    width: 100px;
    height: 211px;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--paper);
    transform-origin: 50% 50%;
    will-change: transform, opacity;
    opacity: 0;
    z-index: 5;
  }
  .device__screen {
    position: absolute;
    inset: 0;
  }
  .device__screen :global(picture),
  .device__screen :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }
  /* The bezel is an inset ring, faded in — the tile had none. Width is
     written per resize as a fraction of the device. */
  .device__bezel {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 var(--bezel, 10px) #16171b;
    opacity: 0;
    pointer-events: none;
  }
  .device__notch {
    position: absolute;
    top: 1.6%;
    left: 50%;
    width: 30%;
    height: 1.8%;
    min-height: 5px;
    transform: translateX(-50%);
    border-radius: var(--r-full);
    background: #0c0d10;
    opacity: 0;
  }

  /* ---- the ground and the grid ------------------------------------ */
  .ground {
    position: absolute;
    inset: 0;
    background: var(--paper);
    opacity: 0;
    z-index: 3;
    pointer-events: none;
  }

  .grid {
    position: absolute;
    inset: 0;
    /* Centred in the space below the fixed header, not the whole frame. */
    padding-top: var(--nav-h);
    z-index: 6;
    opacity: 0;
    pointer-events: none;
    display: grid;
    place-items: center;
  }
  .grid__in {
    /* Width and row pitch are written by services.ts once per resize, by
           formula: fits the width cap and the height. */
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: var(--row, 6rem);
    width: var(--grid-w, 40rem);
  }
  .cell {
    position: relative;
    display: grid;
    place-items: center;
    color: var(--ink);
    border-radius: var(--r-md);
    transition:
      opacity var(--recede-t) var(--ease-io),
      filter var(--recede-t) var(--ease-io);
  }
  .cell__icon {
    /* The disc: 55% of the column pitch, like the screenshot's. */
    width: calc(var(--col, 6rem) * 0.55);
    aspect-ratio: 1;
    border-radius: var(--r-full);
    background: var(--paper-2);
    display: grid;
    place-items: center;
  }
  .cell__icon img {
    width: 56%;
    height: 56%;
  }
  .cell__label {
    position: absolute;
    top: calc(50% + var(--col, 6rem) * 0.275 + var(--s-2));
    left: 0;
    right: 0;
    text-align: center;
    line-height: 1.2;
  }

  /* The phone tile: a true phone's proportions, narrower than its
     column so it grows into Rest B. Indistinguishable from a tile at
     rest — same corners, no bezel. */
  .tile--phone {
    width: 60%;
    aspect-ratio: 360 / 760;
    background: var(--paper);
  }
  .tile--phone :global(img) {
    object-position: 50% 0;
  }
  @media (max-width: 767px) {
    .tile--phone {
      width: 75%;
    }
  }
</style>

<script>
  import { initServices } from '../lib/services';
  initServices();
</script>
