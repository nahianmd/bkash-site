---
/* The site header.

   The structure is the client's sheet (lib/nav-data.ts): three menus
   that open panels — Consumers (the services in groups, plus four
   links), Business, Company — rendered once for the bar's panels and
   once for the drawer's accordion. Support and the language switch
   stay as they were. Link targets are PLACEHOLDER routes.
*/
import Logo from './Logo.astro';
import { NAV_MENUS } from '../lib/nav-data';

interface Props {
  /* Which top-level entry is current. Drives aria-current on both
     the bar and the drawer. */
  current?: 'home' | 'consumers' | 'business' | 'company';
}

const { current } = Astro.props;

/* One structure, rendered twice — the bar's panels and the drawer's
   accordion cannot drift apart the way the prototype's two
   hand-written copies did (audit A7). */
const MENUS = NAV_MENUS;
---

<header class="nav" data-nav>
  <a class="nav__logo" href="/" aria-label="bKash home">
    <Logo class="nav__mark" />
  </a>

  <nav class="nav__links" aria-label="Primary">
    {MENUS.map((m) => (
      <button
        class:list={['nav__top', { 'is-current': current === m.id }]}
        type="button"
        data-menu-button={m.id}
        aria-expanded="false"
        aria-controls={`nav-panel-${m.id}`}
        aria-current={current === m.id ? 'page' : undefined}
      >
        {m.label}
        <span class="nav__chev" aria-hidden="true"></span>
      </button>
    ))}
  </nav>

  <div class="nav__meta">
    <div class="nav__lang">
      <button type="button" aria-current="true">
        EN
      </button>
      <span class="nav__lang-sep" aria-hidden="true">
        /
      </span>
      {/* Visibly present, clearly inert. Hiding it invites "where is
          Bangla?"; leaving it live invites a dead click. Not
          focusable and announced as disabled. specs/needs.md C3. */}
      <button type="button" class="is-inert" tabindex="-1" aria-disabled="true">
        বাংলা
      </button>
    </div>
    <a class="btn btn--outline nav__support" href="#">
      Support
    </a>
  </div>

  <button
    class="nav__burger"
    type="button"
    data-drawer-open
    aria-expanded="false"
    aria-controls="nav-drawer"
  >
    <span class="sr-only">Open menu</span>
    <span class="nav__burger-bar" aria-hidden="true"></span>
    <span class="nav__burger-bar" aria-hidden="true"></span>
    <span class="nav__burger-bar" aria-hidden="true"></span>
  </button>

  {/* The panels: one per menu, below the bar, collapsed until opened.
      Consumers is the wide one — the services in their groups, the
      four links set apart. */}
  {MENUS.map((m) => (
    <div
      class:list={['nav__panel', `nav__panel--${m.id}`]}
      id={`nav-panel-${m.id}`}
      data-menu-panel={m.id}
      hidden
    >
      <div class="wrap nav__panel-in">
        <div class="nav__groups">
          {m.groups.map((g) => (
            <div class="nav__group">
              {g.items ? (
                <>
                  <p class="nav__group-label">{g.label}</p>
                  <ul class="nav__list">
                    {g.items.map((it) => (
                      <li>
                        <a href={it.href}>{it.label}</a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a class="nav__group-label nav__group-link" href={g.href}>
                  {g.label}
                </a>
              )}
            </div>
          ))}
        </div>
        {m.aside && (
          <div class="nav__aside">
            {m.aside.map((it) => (
              <a class="nav__aside-link" href={it.href}>
                {it.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  ))}
</header>

{/* A native <dialog>: focus trap, Escape and focus restore come for
    free. The prototype hand-rolled a div and got none of them. */}
<dialog class="nav__drawer" id="nav-drawer" data-drawer aria-label="Menu">
  <div class="nav__drawer-in">
    <button class="btn btn--ghost nav__drawer-close" type="button" data-drawer-close>
      Close
    </button>

    <nav class="nav__drawer-nav" aria-label="Menu">
      <a
        class:list={['t-h3 nav__drawer-home', { 'is-current': current === 'home' }]}
        href="/"
        aria-current={current === 'home' ? 'page' : undefined}
      >
        Home
      </a>
      {/* The accordion: native <details>, nested where the sheet nests. */}
      {MENUS.map((m) => (
        <details class="nav__acc" data-acc>
          <summary class:list={['t-h3 nav__acc-sum', { 'is-current': current === m.id }]}>
            {m.label}
            <span class="nav__chev" aria-hidden="true"></span>
          </summary>
          <div class="nav__acc-body">
            {m.groups.map((g) =>
              g.items ? (
                <details class="nav__acc nav__acc--sub">
                  <summary class="nav__acc-sum nav__acc-sum--sub">
                    {g.label}
                    <span class="nav__chev" aria-hidden="true"></span>
                  </summary>
                  <ul class="nav__list nav__list--drawer">
                    {g.items.map((it) => (
                      <li>
                        <a href={it.href}>{it.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a class="nav__acc-link" href={g.href}>
                  {g.label}
                </a>
              ),
            )}
            {m.aside?.map((it) => (
              <a class="nav__acc-link nav__acc-link--aside" href={it.href}>
                {it.label}
              </a>
            ))}
          </div>
        </details>
      ))}
    </nav>

    {/* At 390px this is where Support lives — a full-width tap
        target rather than a cramped pill in the bar. The criterion
        is that Support is present on both pages, and it is. */}
    <a class="btn btn--primary nav__drawer-support" href="#">
      Support
    </a>

    <div class="nav__drawer-lang">
      <button type="button" aria-current="true">
        EN
      </button>
      <span class="nav__lang-sep" aria-hidden="true">
        /
      </span>
      <button type="button" class="is-inert" tabindex="-1" aria-disabled="true">
        বাংলা
      </button>
    </div>
  </div>
</dialog>

<style>
  /* ---- the bar ----
     SOLID IS THE DEFAULT. The prototype had it inverted — white
     links on a transparent ground, with `.is-solid` as the override
     — which means a JS failure leaves white on white. Here a page
     with no dark header, or with JS broken, is legible. */
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: var(--s-6);
    padding-inline: var(--gutter);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 1px 0 var(--pink-line);
    transition:
      background var(--t-base) var(--ease-io),
      color var(--t-base) var(--ease-io),
      box-shadow var(--t-base) var(--ease-io);
  }

  /* Transparent, and ONLY when JS has positively established that a
     dark full-bleed header is under the nav band. The state needs
     its own class rather than `:not(.is-solid)`: the default state
     has no class at all, so a `:not()` rule would match it and make
     the default transparent — which is the white-on-white failure
     this file is meant to prevent. */
  .nav.is-over-dark,
  :global(html[data-nav-ground='dark']) .nav {
    background: transparent;
    color: var(--paper);
    box-shadow: none;
  }

  /* The transparent nav sits over whatever the camera is showing, so
     it carries its own scrim rather than trusting the artwork. */
  .nav::before {
    content: '';
    position: absolute;
    /* Reaches well below the band and eases out, so it reads as a soft
             darkening of the top of the picture rather than a bar. */
    inset: 0 0 calc(-1 * var(--s-10));
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 55%) 0%,
      rgb(0 0 0 / 40%) 30%,
      rgb(0 0 0 / 18%) 65%,
      rgb(0 0 0 / 0) 100%
    );
    opacity: 0;
    transition: opacity var(--t-base) var(--ease-io);
    pointer-events: none;
  }

  .nav.is-over-dark::before,
  :global(html[data-nav-ground='dark']) .nav::before {
    opacity: 1;
  }

  .nav > * {
    position: relative;
  }

  /* ---- logo ---- */
  .nav__logo {
    flex: none;
    display: block;
    width: 6.4rem;
  }

  .nav__mark {
    width: 100%;
    height: auto;
  }

  /* ---- top-level links ----
     The mega panels are gone: with two real pages behind them they
     were three hover targets promising depth that is not there. */
  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(0.875rem, 2.2vw, 2rem);
    margin-inline-start: var(--s-4);
  }

  .nav__top {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: inherit;
    opacity: 0.82;
    transition:
      opacity var(--t-fast) var(--ease-io),
      color var(--t-fast) var(--ease-io);
  }

  .nav__top:hover {
    opacity: 1;
    color: var(--pink);
  }

  .nav__top.is-current {
    opacity: 1;
    color: var(--pink);
    font-weight: 600;
  }

  /* On the transparent nav, pink-on-photograph is the H4 mistake.
     The current item stays white and carries its weight instead. */
  .nav.is-over-dark .nav__top.is-current,
  .nav.is-over-dark .nav__top:hover,
  :global(html[data-nav-ground='dark']) .nav .nav__top.is-current,
  :global(html[data-nav-ground='dark']) .nav .nav__top:hover {
    color: var(--paper);
  }

  .nav__top {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }
  .nav__top[aria-expanded='true'] {
    opacity: 1;
    color: var(--pink);
  }
  /* The chevron: a rotated corner, turns when open. */
  .nav__chev {
    display: inline-block;
    width: 0.45em;
    height: 0.45em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.15em) rotate(45deg);
    transition: transform var(--t-fast) var(--ease-io);
  }
  [aria-expanded='true'] > .nav__chev,
  details[open] > summary > .nav__chev {
    transform: translateY(0.1em) rotate(225deg);
  }

  /* While a panel is open the bar is solid whatever the ground, so
     the panel and the bar read as one sheet. */
  .nav.is-open,
  :global(html[data-nav-ground='dark']) .nav.is-open {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 1px 0 var(--pink-line);
  }
  .nav.is-open::before {
    opacity: 0;
  }
  :global(html[data-nav-ground='dark']) .nav.is-open .nav__top:hover,
  :global(html[data-nav-ground='dark']) .nav.is-open .nav__top[aria-expanded='true'] {
    color: var(--pink);
  }

  /* ---- the panels ----
     A paper sheet under the bar. Collapsed: hidden. Opening: a short
     fade and a few px of rise, from the tokens. */
  /* `.nav .nav__panel`, not `.nav__panel`: the bar's own `.nav > *`
     rule sets its children relative, and would otherwise win. */
  .nav .nav__panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--paper);
    color: var(--ink);
    box-shadow:
      0 1px 0 var(--pink-line) inset,
      var(--e-3);
    padding-block: var(--s-7);
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity var(--t-base) var(--ease-io),
      transform var(--t-base) var(--ease);
    max-height: calc(var(--vh) - var(--nav-h));
    overflow: auto;
  }
  /* Same strength as the rule above, or the collapsed opacity wins. */
  .nav .nav__panel.is-in {
    opacity: 1;
    transform: none;
  }
  .nav__panel-in {
    display: grid;
    gap: var(--s-8);
  }
  .nav__panel--consumers .nav__panel-in {
    grid-template-columns: 1fr auto;
  }
  .nav__groups {
    display: grid;
    gap: var(--s-6) var(--s-7);
  }
  .nav__panel--consumers .nav__groups {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .nav__panel--business .nav__groups,
  .nav__panel--company .nav__groups {
    grid-template-columns: repeat(2, minmax(0, 20rem));
  }
  .nav__panel--business .nav__list,
  .nav__panel--company .nav__list {
    columns: 2;
    column-gap: var(--s-7);
  }
  .nav__group-label {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--s-3);
  }
  .nav__group-link {
    color: var(--ink);
  }
  .nav__group-link:hover {
    color: var(--pink);
  }
  .nav__list {
    display: grid;
    gap: var(--s-2);
    font-size: var(--fs-sm);
  }
  .nav__list a {
    color: var(--ink);
  }
  .nav__list a:hover {
    color: var(--pink);
  }
  .nav__aside {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding-inline-start: var(--s-7);
    border-inline-start: 1px solid var(--pink-line);
    min-width: 14rem;
  }
  .nav__aside-link {
    font-weight: 600;
    color: var(--ink);
  }
  .nav__aside-link:hover {
    color: var(--pink);
  }

  /* ---- meta ---- */
  .nav__meta {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    font-size: var(--fs-sm);
  }

  .nav__lang {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .nav__lang button {
    font-size: var(--fs-sm);
    font-weight: 500;
    opacity: 0.8;
  }

  .nav__lang button[aria-current='true'] {
    opacity: 1;
    font-weight: 600;
  }

  .nav__lang-sep {
    opacity: 0.3;
  }

  /* ---- burger ---- */
  /* A full 44px tap target without changing the visual mark. The
     three bars are only 14.5px tall, so padding alone measured
     44x39 — min-height plus centring gets the short axis there
     too. Pulled flush to the gutter by a negative inline margin. */
  .nav__burger {
    display: none;
    margin-inline-start: auto;
    padding-inline: var(--s-3);
    margin-inline-end: calc(-1 * var(--s-3));
    min-width: 2.75rem;
    min-height: 2.75rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .nav__burger-bar {
    display: block;
    width: 20px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
  }

  .nav__burger-bar + .nav__burger-bar {
    margin-top: 5px;
  }

  /* ---- the drawer ----
     A full-screen dialog on paper. At 390px this IS the primary
     navigation, not a fallback for a bar that did not fit. */
  .nav__drawer {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
  }

  .nav__drawer::backdrop {
    background: rgb(0 0 0 / 40%);
  }

  .nav__drawer-in {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-5);
    padding: var(--gutter);
    /* Clear the notch and the home indicator. */
    padding-top: calc(var(--gutter) + env(safe-area-inset-top, 0px));
    padding-bottom: calc(var(--gutter) + env(safe-area-inset-bottom, 0px));
  }

  /* Same side as the burger, so the thumb does not travel. */
  .nav__drawer-close {
    align-self: flex-end;
  }

  .nav__drawer-nav {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .nav__drawer-nav a {
    color: var(--ink);
  }

  .nav__drawer-nav a.is-current,
  .nav__acc-sum.is-current {
    color: var(--pink);
  }

  /* The accordion. Native <details>; the summary is the row. */
  .nav__acc {
    width: 100%;
  }
  .nav__acc-sum {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    cursor: pointer;
    list-style: none;
    padding-block: var(--s-2);
    color: var(--ink);
  }
  .nav__acc-sum::-webkit-details-marker {
    display: none;
  }
  .nav__acc-sum--sub {
    font-size: var(--fs-body);
    font-weight: 600;
  }
  .nav__acc-body {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-2) 0 var(--s-4) var(--s-4);
    border-inline-start: 1px solid var(--pink-line);
  }
  .nav__acc--sub {
    padding-inline-start: 0;
  }
  .nav__list--drawer {
    padding: var(--s-2) 0 var(--s-3) var(--s-4);
    gap: var(--s-3);
    font-size: var(--fs-body);
  }
  .nav__acc-link {
    display: block;
    padding-block: var(--s-2);
    font-weight: 600;
    color: var(--ink);
  }
  .nav__acc-link--aside {
    font-weight: 500;
  }

  .nav__drawer-support {
    align-self: stretch;
    justify-content: center;
  }

  .nav__drawer-lang {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-sm);
  }

  /* ---- 390px is a composition, not an override ----
     Three things in the bar and no more: logo, language, burger.
     Support moves into the drawer, where it is a full-width tap
     target instead of a cramped pill. */
  @media (max-width: 900px) {
    .nav__links,
    .nav__support,
    .nav__panel {
      display: none;
    }

    /* Two auto start-margins in one flex row SPLIT the free space
       between them, so the language pair sat near the middle of the bar
       instead of at its right end (Nahian, 2026-09-22). The comment here
       used to say the burger took the margin at this width; both did.

       The meta block owns it now and the burger gives its up, so the
       whole free space collects ahead of the language and it settles
       beside the burger — one nav gap away, hard against the gutter. */
    .nav__burger {
      display: flex;
      margin-inline-start: 0;
    }

    .nav__meta {
      margin-inline-start: auto;
    }
  }

  @media (max-width: 900px) {
    .nav {
      gap: var(--s-4);
    }
  }
</style>

<script>
  import { initNav } from '../lib/nav';
  initNav();
</script>
