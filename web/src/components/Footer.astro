    'M12.09 13.119c-.936 1.932-2.217 4.548-2.853 5.728-.616 1.074-1.127.931-1.532.029-1.406-3.321-4.293-9.144-5.651-12.409-.251-.601-.441-.987-.619-1.139-.181-.15-.554-.24-1.122-.271C.103 5.033 0 4.982 0 4.898v-.455l.052-.045c.924-.005 5.401 0 5.401 0l.51.045v.434c0 .119-.075.176-.226.176l-.564.031c-.485.029-.727.164-.727.436 0 .135.053.33.166.601 1.082 2.646 4.818 10.521 4.818 10.521l.136.046 2.411-4.81-.482-1.067-1.658-3.264s-.318-.654-.428-.872c-.728-1.443-.712-1.518-1.447-1.617-.207-.023-.313-.05-.313-.149v-.468l.06-.045h4.292l.113.037v.451c0 .105-.076.15-.227.15l-.308.047c-.792.061-.661.381-.136 1.422l1.582 3.252 1.758-3.504c.293-.64.233-.801.111-.947-.07-.084-.305-.22-.812-.24l-.201-.021a.228.228 0 0 1-.148-.055.168.168 0 0 1-.068-.131v-.436l.064-.05c1.043-.005 4.02 0 4.02 0l.06.05v.438c0 .106-.083.17-.243.191-.71.075-.821.4-1.19 1.106-.75 1.485-1.628 3.111-2.431 4.617l2.583 5.291.185.047 4.352-10.478c.181-.483.161-.815-.045-.994-.211-.18-.383-.293-1.023-.324l-.503-.031c-.121 0-.181-.044-.181-.135v-.45l.061-.045h4.669l.061.045v.45c0 .091-.076.135-.227.135l-.302.031c-.622.06-.879.264-1.086.729-.18.417-5.265 11.966-6.087 13.83-.407.925-.815.856-1.264-.06-.647-1.324-1.833-3.884-2.446-5.226z',
