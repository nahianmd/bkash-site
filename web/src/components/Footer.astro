---

<footer class="foot">
  <div class="wrap">
    <div class="foot__grid">
      {/* Left: the one mark, then the accounts under two titles — the
          company's own, and the #AmarbKash community's (Nahian,
          2026-09-24; the #AmarbKash lockup that used to head the second
          row is gone). */}
      <div class="foot__brand">
        <a class="foot__logo" href="/" aria-label="bKash home">
          <Logo class="foot__mark" />
        </a>
        <p class="t-eyebrow foot__head foot__social-head">Official platforms</p>
        <ul class="foot__social" aria-label="Official platforms">
          {SOCIAL.map((s) => (
            <li>
              <a
                class="foot__social-link"
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`bKash on ${s.label}`}
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={ICONS[s.label]}></path>
                </svg>
              </a>
            </li>
          ))}
        </ul>

        {AMAR_SOCIAL.length > 0 && (
          <p class="t-eyebrow foot__head foot__social-head">Community platforms</p>
        )}
        {AMAR_SOCIAL.length > 0 && (
          <ul class="foot__social" aria-label="Community platforms">
            {AMAR_SOCIAL.map((s) => (
              <li>
                <a
                  class="foot__social-link"
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Amar bKash on ${s.label}`}
                >
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={ICONS[s.label]}></path>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      {FOOTER_COLUMNS.map((col) => (
        <div class="foot__col">
          <p class="t-eyebrow foot__head">{col.label}</p>
          {col.items.map((it) => (
            <a href={it.href}>{it.label}</a>
          ))}
        </div>
      ))}
    </div>

    {/* The phone's rendering of the same columns (Nahian, 2026-09-24):
        side by side, three lists of 5, 8 and 8 left one column ragged and
        Company stranded on a row of its own. Here each is a row that
        opens — native <details>, as the drawer's accordion. The columns
        above are display:none at this width, so nothing is read twice. */}
    <div class="foot__acc">
      {FOOTER_COLUMNS.map((col) => (
        <details class="foot__acc-item">
          <summary class="t-eyebrow foot__acc-sum">
            {col.label}
            <span class="foot__chev" aria-hidden="true"></span>
          </summary>
          <div class="foot__acc-body">
            {col.items.map((it) => (
              <a href={it.href}>{it.label}</a>
            ))}
          </div>
        </details>
      ))}
    </div>

    <div class="foot__base t-sm">
      <span>&copy; {YEAR} bKash Limited. All rights reserved.</span>
      <a href="#">Privacy notice</a>
      <a href="#">Terms &amp; conditions</a>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--night);
    color: var(--on-night-2);
    /* Longhands, not `padding-block`: the CSS minifier drops a
             `padding-bottom` that follows the shorthand when it carries a
             var(), and the rule vanishes from the built sheet with no error. */
    padding-top: clamp(3rem, 7vh, 5rem);
    /* the dock floats over the foot of the page */
    padding-bottom: calc(clamp(3rem, 7vh, 5rem) + var(--search-space));
  }

  /* Four explicit columns, not auto-fit.

     auto-fit was tried and measured: at 1920 the content box is
     1216px, which fits SIX 10rem tracks, so four columns of content
     left two empty tracks and a band of dead space inside .wrap.
     That is audit A5 — "auto-fill columns not filling" — reproduced
     exactly. And at 390 it collapsed to one column, because two
     10rem tracks plus the gap need 344px and a 15px scrollbar
     leaves 335px. A layout that flips between one and two columns
     on the presence of a scrollbar is not a composition.

     minmax(0, 1fr) rather than 1fr so a long label cannot push a
     track wider than its share. The brand column takes a little more:
     the mark needs a readable size, the link columns do not. */
  .foot__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    margin-bottom: var(--s-8);
  }

  /* ---- the brand column ---- */
  .foot__logo {
    display: block;
    width: 8.5rem;
    /* The mark's letterforms ride currentColor; on the night ground
             that has to be the light ink, not the body's dimmed one. */
    color: var(--on-night);
  }

  .foot__mark {
    width: 100%;
    height: auto;
  }

  .foot__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin: var(--s-5) 0 0;
    padding: 0;
    list-style: none;
  }

  /* 44px tap targets without four visible boxes: the padding does the
     work, the glyph stays 20px. The first is pulled back by its own
     padding so the row starts on the gutter, flush with the mark. */
  .foot__social-link {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-full);
    color: var(--on-night-2);
    transition:
      color var(--t-fast) var(--ease-io),
      background var(--t-fast) var(--ease-io);
  }

  .foot__social li:first-child .foot__social-link {
    margin-inline-start: calc(-1 * var(--s-3));
  }

  .foot__social-link svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .foot__social-link:hover {
    color: var(--on-night);
    background: var(--on-night-line);
  }

  .foot__social-link:focus-visible {
    outline: 2px solid var(--pink);
    outline-offset: 2px;
  }

  /* Each row of accounts under its title: the columns' own head style,
     spaced off the mark or the row above, the icons close beneath. */
  .foot__social-head {
    margin: var(--s-6) 0 0;
  }
  .foot__social-head + .foot__social {
    margin-top: var(--s-2);
  }

  /* ---- the link columns ---- */
  .foot__head {
    color: var(--on-night);
    margin-bottom: var(--s-4);
  }

  .foot__col a {
    display: block;
    color: var(--on-night-2);
    /* A 40px+ tap row at 14px type without a visible change. */
    padding-block: var(--s-2);
    font-size: var(--fs-sm);
  }

  .foot__col a:hover {
    color: var(--on-night);
  }

  /* ---- the phone's accordion ---- */
  .foot__acc {
    display: none;
  }
  .foot__acc-item {
    border-top: 1px solid var(--on-night-line);
  }
  .foot__acc-item:last-child {
    border-bottom: 1px solid var(--on-night-line);
  }
  /* A 48px row: the whole bar is the tap target. */
  .foot__acc-sum {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    color: var(--on-night);
    cursor: pointer;
    list-style: none;
  }
  .foot__acc-sum::-webkit-details-marker {
    display: none;
  }
  /* The drawer's chevron: a rotated corner, turned when open. */
  .foot__chev {
    width: 0.5em;
    height: 0.5em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.15em) rotate(45deg);
    transition: transform var(--t-fast) var(--ease-io);
  }
  .foot__acc-item[open] .foot__chev {
    transform: translateY(0.1em) rotate(225deg);
  }
  .foot__acc-body {
    display: grid;
    padding-bottom: var(--s-4);
  }
  .foot__acc-body a {
    color: var(--on-night-2);
    padding-block: var(--s-2);
    font-size: var(--fs-sm);
  }
  .foot__acc-body a:hover {
    color: var(--on-night);
  }

  /* The phone: the brand block alone in the grid, the three link
     columns swapped for the accordion beneath it. */
  @media (max-width: 767px) {
    .foot__grid {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: var(--s-6);
    }
    .foot__col {
      display: none;
    }
    /* No gap and no closing line of its own: the base's top rule closes
       the last row, so two hairlines never stack. */
    .foot__acc {
      display: block;
    }
    .foot__acc-item:last-child {
      border-bottom: 0;
    }
  }

  .foot__base {
    border-top: 1px solid var(--on-night-line);
    padding-top: var(--s-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-6);
    align-items: center;
    color: var(--on-night-3);
  }

  .foot__base a {
    color: var(--on-night-2);
  }

  .foot__base a:hover {
    color: var(--on-night);
  }

  /* The notice on its own line, the two links together beneath it. */
  @media (max-width: 767px) {
    .foot__base span {
      flex-basis: 100%;
    }
  }
</style>
