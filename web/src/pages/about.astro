---
/* About bKash — the prototype's page (reference/prototype/about.html),
   its content and its layout, in this site's design language: the
   tokens and type steps, `.on-photo` for anything on a photograph,
   --vh and ScrollTrigger for the Journey Wall, images through
   astro:assets, no inline styles.

   Content is real — board names, the CEO's words, customers' words —
   and cleared for the pitch, not yet for a public URL (CLAUDE.md). */
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { STATS, TRIAD, BOARD, INVESTORS, VOICES } from '../lib/about-data';

import banner from '../assets/img/about/banner.jpg';
import ceo from '../assets/img/about/kamal-quadir.jpg';
import journey from '../assets/img/about/journey-wall.jpg';
import careers from '../assets/img/about/careers.jpg';
import road from '../assets/img/about/road-ahead.jpg';
import collage from '../assets/img/about/collage-bird.png';

const boardImgs = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/about/board/*.jpg',
  {
    eager: true,
  },
);
const investorImgs = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/about/investors/*.png',
  { eager: true },
);
const voiceImgs = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/about/voices/*.jpg',
  {
    eager: true,
  },
);
const boardImg = (f: string) => boardImgs[`../assets/img/about/board/${f}.jpg`].default;
const investorImg = (f: string) =>
  investorImgs[`../assets/img/about/investors/${f}.png`].default;
const voiceImg = (f: string) => voiceImgs[`../assets/img/about/voices/${f}.jpg`].default;

/* The stats' icons (Nahian, 2026-09-23): line drawings on a 24 grid,
   stroked in currentColor so the CSS colours them. People for
   customers; a person and a banknote for agents, the "human ATMs"; a
   shopfront for merchants; an app grid with room for more for products
   and services. */
const STAT_ICONS: Record<string, string> = {
  customers:
    '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 19c0-3.1 2.5-5.5 5.5-5.5s5.5 2.4 5.5 5.5"/><circle cx="16.5" cy="9" r="2.6"/><path d="M16.2 13.6h.3c2.5 0 4.5 2 4.5 4.6"/>',
  agents:
    '<circle cx="8" cy="7" r="3"/><path d="M2.5 18.5c0-3 2.5-5.3 5.5-5.3 1.3 0 2.5.4 3.4 1.2"/><rect x="12.5" y="13" width="9" height="6" rx="1"/><circle cx="17" cy="16" r="1.3"/>',
  merchants:
    '<path d="M3.5 9.5 5 4.5h14l1.5 5"/><path d="M3.5 9.5a2.8 2.8 0 0 0 5.67 0 2.8 2.8 0 0 0 5.66 0 2.8 2.8 0 0 0 5.67 0"/><path d="M5 12v7.5h14V12"/><path d="M10 19.5V15h4v4.5"/>',
  products:
    '<rect x="4" y="4" width="6.5" height="6.5" rx="1.6"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.6"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.6"/><path d="M16.75 13.5V20M13.5 16.75H20"/>',
};
---

<Base
  title="About bKash — Financial freedom for millions"
  description="A secure digital account where millions store value and decide how to use it."
  current="company"
>
  <main class="about">
    <!-- ============================== HERO ============================== -->
    <header class="ab-hero">
      <Picture
        src={banner}
        alt="bKash customers across Bangladesh"
        widths={[640, 1024, 1536, 2200]}
        sizes="100vw"
        formats={['avif', 'webp']}
        layout="none"
        loading="eager"
        fetchpriority="high"
        pictureAttributes={{ class: 'ab-hero__img' }}
      />
      <div class="wrap ab-hero__body">
        <div class="on-photo ab-hero__copy" data-reveal>
          <p class="t-eyebrow ab-hero__eyebrow">About bKash</p>
          <h1 class="t-display">Empowering 85M Bangladeshis with Financial Freedom</h1>
          <p class="t-lead ab-hero__lead">
            Bridging the everyday economy and digital finance, bKash brought millions into the
            formal economy who now have controls on their own money.
          </p>
          <a class="btn btn--primary ab-hero__cta" href="#story">
            Be part of the story →
          </a>
        </div>
      </div>
      <!-- The nav is transparent over the banner, solid below it. -->
      <div data-nav-dark-end></div>
    </header>

    <!-- ============================== STATS ============================== -->
    <section class="ab-section" id="story" aria-label="bKash in numbers">
      <div class="wrap">
        <div class="stats">
          {STATS.map((s) => (
            <div class="stats__item" data-reveal data-reveal-group="stats">
              <svg
                class="stats__icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={STAT_ICONS[s.icon]}
              />
              <p class="stats__num t-num">
                <span data-count={s.count} data-suffix={s.suffix}>
                  0
                </span>
              </p>
              <p class="stats__label">{s.label}</p>
              <p class="stats__note t-sm">{s.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================== PLATFORM ============================== -->
    <section class="ab-section ab-section--tint" aria-label="Our platform">
      <div class="wrap">
        {/* Copy left, the mark right — the mark drawn from the faces the
            copy is about, which is the same idea the homepage's bird
            ends on. Documentary photographs, so Rule 1 holds. */}
        <div class="revolution">
          <div class="ab-head revolution__copy">
            <p class="t-eyebrow ab-head__eyebrow" data-reveal>
              The Revolution
            </p>
            <h2 class="t-h1" data-reveal>
              bKash started with one core idea: everyone should have the power to control their
              own money
            </h2>
            <p class="t-lead ab-head__lead" data-reveal>
              With its unmatched last-mile reach, that one idea changed how Bangladesh
              transacts. Today, millions use bKash to access crucial financial services, turning
              everyday inclusion into an entire financial ecosystem.
            </p>
          </div>
          <Picture
            src={collage}
            alt="The bKash mark, made from photographs of customers across Bangladesh"
            widths={[400, 640, collage.width]}
            sizes="(max-width: 767px) 128vw, 45vw"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            layout="none"
            loading="lazy"
            pictureAttributes={{ class: 'revolution__mark', 'data-reveal': '' }}
          />
        </div>
        <div class="triad">
          {TRIAD.map((t) => (
            <div class="triad__card" data-reveal data-reveal-group="triad">
              <h3 class="t-h3">{t.title}</h3>
              <p class="t-body triad__line">{t.line}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================== INVESTORS ============================== -->
    <section class="ab-section" aria-label="Our investors">
      <div class="wrap">
        <div class="ab-head">
          <p class="t-eyebrow ab-head__eyebrow" data-reveal>
            Backed by
          </p>
          <h2 class="t-h1" data-reveal>
            The best in the business
          </h2>
        </div>
        <div class="investors" data-investors>
          {INVESTORS.map((v) => {
            const im = investorImg(v.file);
            return (
              <div class="investors__item" data-reveal data-reveal-group="investors">
                <Image src={im} alt={v.name} width={im.width} layout="none" data-w={im.width} />
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ============================== BOARD ============================== -->
    <section class="ab-section ab-section--tint" aria-label="Board of directors">
      <div class="wrap">
        <div class="ab-head">
          <p class="t-eyebrow ab-head__eyebrow" data-reveal>
            Leadership
          </p>
          <h2 class="t-h1" data-reveal>
            Board of directors
          </h2>
        </div>
        <div class="board">
          {BOARD.map((p) => (
            <figure class="board__card" data-reveal data-reveal-group="board">
              <Image
                src={boardImg(p.file)}
                alt={p.name}
                width={480}
                layout="none"
                class="board__img"
                loading="lazy"
              />
              <figcaption>
                <p class="board__name">{p.name}</p>
                <p class="board__role t-sm">{p.role}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================== CEO QUOTE ============================== -->
    <section class="ab-section ab-section--dark ab-ceo" aria-label="From the Chief Executive">
      <div class="wrap">
        <div class="quote">
          <Image
            src={ceo}
            alt="Kamal Quadir, Founder and Chief Executive Officer of bKash"
            width={ceo.width}
            layout="none"
            class="quote__portrait"
            loading="lazy"
            data-reveal
          />
          <div class="quote__body" data-reveal>
            {/* The page's lead step, as every other section's copy: the
                quote step made the section, and so the photo, too big
                (Nahian, 2026-09-23). */}
            <blockquote class="t-lead">
              “Millions of Bangladeshis once hid their money under the mattress simply because
              access to financial services was out of reach. bKash became the collective
              mattress for the country, putting money within people’s control and giving them
              the freedom to use it on their terms. And somewhere along the way, bKash became a
              verb. That was never accidental. It was planned. And our ambition remains just as
              deliberate: to keep going until we ensure financial inclusion for all.”
            </blockquote>
            <p class="quote__attr t-sm">
              <strong>Kamal Quadir</strong>Founder &amp; Chief Executive Officer, bKash
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================== JOURNEY WALL ============================== -->
    <section class="wall" data-wall aria-label="The bKash journey">
      <div class="wall__pin" data-wall-pin>
        <div class="wall__head">
          <p class="t-eyebrow wall__eyebrow">Our journey</p>
          <h2 class="t-h2">15 Years of Moving Bangladesh Forward</h2>
        </div>
        <div class="wall__viewport">
          <div class="wall__track" data-wall-track>
            {/* The client's 60×10 ft wall (Journey Wall____60x10__ft.ai,
                2026-09-23), rendered from the .ai and cropped to the wall.
                Sized by height, so `sizes` is the width that height gives
                at 6:1: ~1900px on a phone (0.38 --vh), ~3650px on desktop
                (38rem cap). */}
            <Image
              src={journey}
              alt="The bKash journey from 2012 to 2026"
              widths={[3800, 7600]}
              sizes="(max-width: 767px) 1900px, 3650px"
              layout="none"
              class="wall__img"
              loading="lazy"
            />
          </div>
        </div>
        <div class="wall__bar">
          <div class="wall__fill" data-wall-fill></div>
        </div>
      </div>
    </section>

    <!-- ============================== VOICES ============================== -->
    <section class="ab-section" aria-label="Voices of bKash">
      <div class="wrap">
        <div class="ab-head">
          <p class="t-eyebrow ab-head__eyebrow" data-reveal>
            Voices of bKash
          </p>
          <h2 class="t-h1" data-reveal>
            In their own words
          </h2>
        </div>
        <div class="voices">
          {VOICES.map((v) => (
            <figure class="voices__card" data-reveal data-reveal-group="voices">
              <Image
                src={voiceImg(v.file)}
                alt={v.name}
                width={260}
                layout="none"
                class="voices__face"
                loading="lazy"
              />
              <figcaption>
                <p class="t-eyebrow voices__tag">{v.tag}</p>
                <blockquote class="t-body voices__quote">“{v.quote}”</blockquote>
                <p class="voices__who t-sm">
                  <strong>{v.name}</strong>
                  {v.city}
                </p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================== CAREERS ============================== -->
    <section class="ab-section ab-section--tint" aria-label="Careers at bKash">
      <div class="wrap">
        <div class="split">
          <div class="split__copy">
            <p class="t-eyebrow ab-head__eyebrow" data-reveal>
              Careers at bKash
            </p>
            <h2 class="t-h1 split__title" data-reveal>
              Build What Matters
            </h2>
            <p class="t-lead ab-head__lead split__lead" data-reveal>
              For 15 years, bKash has been expanding financial access across Bangladesh. What
              began as a way to move money has grown into a financial ecosystem reaching every
              corner.
            </p>
            <p class="t-body split__values-head" data-reveal>
              Five values shape how we work:
            </p>
            <p class="careers__values" data-reveal>
              Customer-Centric. Collaborative. Innovative. Agile. Ethical.
            </p>
            <p class="t-body split__body" data-reveal>
              We challenge convention, work together, put customers first, and do what is right.
            </p>
            <a class="btn btn--primary split__cta" href="#" data-reveal>
              Come Build What’s Next
            </a>
          </div>
          <Image
            src={careers}
            alt="Two bKash colleagues in the office"
            width={1200}
            layout="none"
            class="split__img"
            loading="lazy"
            data-reveal
          />
        </div>
      </div>
    </section>

    <!-- ============================== ROAD AHEAD ============================== -->
    <section class="ab-section ab-section--dark road" aria-label="The road ahead">
      <div class="wrap">
        <div class="ab-head road__head">
          <h2 class="t-h1" data-reveal>
            The Road Ahead
          </h2>
          <p class="t-lead ab-head__lead" data-reveal>
            The next chapter is bigger than access. We are building towards a country where
            cashless is the norm, every transaction is secure, digital finance is understood and
            trusted, and advanced financial services are within everyone’s reach.
          </p>
          <p class="t-body road__body" data-reveal>
            After 15 years of transforming how Bangladesh moves money, the ambition is not
            simply to keep up with a changing Bangladesh, but to keep changing it, at a scale
            that matters to the entire economy.
          </p>
        </div>
      </div>
      <Image
        src={road}
        alt="People walking a pink road from village to city"
        width={1600}
        layout="none"
        class="road__img"
        loading="lazy"
        data-reveal
      />
    </section>
  </main>
</Base>

<style>
  /* ---- rhythm ---- */
  .ab-section {
    padding-block: clamp(4.5rem, 11vh, 8rem);
  }
  .ab-section--tint {
    background: var(--paper-2);
  }
  .ab-section--dark {
    background: var(--night);
    color: var(--on-night);
  }
  .ab-head {
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
  .ab-head__eyebrow {
    color: var(--pink);
    margin-bottom: var(--s-4);
  }
  .ab-head h2 {
    margin-bottom: var(--s-4);
  }
  .ab-head__lead {
    color: var(--ink-2);
  }
  .ab-section--dark .ab-head__eyebrow {
    color: var(--pink-lift);
  }
  .ab-section--dark .ab-head__lead {
    color: var(--on-night-2);
  }

  /* ---- hero: the banner, the copy on its ground (Rule 3) ---- */
  .ab-hero {
    position: relative;
    min-height: min(calc(var(--vh) * 0.86), 46rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--night);
  }
  .ab-hero :global(.ab-hero__img),
  .ab-hero :global(.ab-hero__img img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
  }
  .ab-hero__body {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--nav-h) + var(--s-8));
    padding-bottom: clamp(3rem, 8vh, 5.5rem);
  }
  .ab-hero__copy {
    max-width: 44rem;
  }
  .ab-hero__eyebrow {
    color: var(--pink-lift);
    margin-bottom: var(--s-4);
  }
  .ab-hero__copy h1 {
    margin-bottom: var(--s-5);
  }
  .ab-hero__lead {
    color: var(--on-night-2);
    max-width: 42ch;
  }
  .ab-hero__cta {
    margin-top: var(--s-6);
  }

  /* ---- stats ---- */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  /* Quieter (Nahian, 2026-09-23): a hairline over each figure, the
     figure in dark ash, and the pink moved to the icon and the label. */
  .stats__item {
    border-top: 1px solid var(--pink);
    padding-top: var(--s-5);
  }
  .stats__icon {
    display: block;
    width: 2rem;
    height: 2rem;
    color: var(--pink);
    margin-bottom: var(--s-4);
  }
  .stats__num {
    font-size: var(--fs-display);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 700;
    color: var(--ink-2);
    margin-bottom: var(--s-3);
  }
  .stats__label {
    font-weight: 600;
    color: var(--pink);
    margin-bottom: var(--s-2);
  }
  .stats__note {
    color: var(--ink-3);
    /* The deck asks for two lines under every figure; 28ch is the measure
             at which all four wrap to two and none to three. */
    max-width: 28ch;
  }

  /* ---- the revolution: copy beside the mark ---- */
  .revolution {
    display: grid;
    /* 1.6 : 1 is where the headline settles at four lines — measured at
             1920, it runs to six at 1.1 and five at 1.35, and taking the mark
             below this buys no further line. */
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
  /* The head fills its column here and the section spaces the pair. */
  .revolution__copy {
    max-width: none;
    margin-bottom: 0;
  }
  .revolution :global(.revolution__mark) {
    display: block;
  }
  .revolution :global(.revolution__mark img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---- platform triad ---- */
  /* No boxes (Nahian, 2026-09-23): open text under a hairline, the
     same treatment and rhythm as the stats above. */
  .triad {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  .triad__card {
    border-top: 1px solid var(--pink);
    padding-top: var(--s-5);
  }
  .triad__card h3 {
    margin-bottom: var(--s-3);
  }
  .triad__line {
    color: var(--ink-2);
  }

  /* ---- investors: flex, so each logo keeps its true width ---- */
  .investors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.25rem, 3vh, 2rem) clamp(1rem, 2.4vw, 2.25rem);
  }
  .investors__item {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
  }
  .investors__item :global(img) {
    /* width written by about.ts from one shared divisor */
    max-width: none;
    height: auto;
  }

  /* ---- board: one crop, one caption block ----
     The portraits run 175px to 2400px across in mixed aspects. They were
     monochrome by default, which made twelve sources read as one set;
     Nahian, 2026-09-20: natural colour instead, so the crop and the
     caption block are what hold the set together (Rule 1 — documentary
     left real).

     Hover changes the tile's SHAPE, not its size: two opposite corners
     open from --r-md to --r-xl and back, so the square becomes a leaf.
     Nothing reflows and no neighbour moves — the people row's rejected
     grow-on-hover is not repeated here. */
  .board {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }
  .board__card {
    margin: 0;
  }
  .board :global(.board__img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--r-md);
    margin-bottom: var(--s-3);
    background: var(--paper-2);
    transition: border-radius var(--t-base) var(--ease);
  }
  .board__card:hover :global(.board__img) {
    border-radius: var(--r-xl) var(--r-md);
  }
  .board__name {
    font-weight: 600;
    letter-spacing: -0.012em;
  }
  .board__role {
    color: var(--ink-3);
  }

  /* ---- the CEO ---- */
  /* A cinematic split (Nahian, 2026-09-23). The photograph is composed
     for it: him on the right third, plain brick on the left two. So the
     photo runs from the section's right, top and bottom edges across a
     bit over half its width, and its left side — the empty wall, never
     him — fades into --night, the same dissolve as the phone's. The
     quote sits on the dark in the left column and ends where the fade
     begins. The photo is barely cropped from its own landscape, so it
     is barely enlarged. */
  .ab-ceo {
    position: relative;
    overflow: hidden;
  }
  .quote {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--s-7);
    align-items: center;
  }
  /* Above the photo: the panel is positioned and the text is not, so
     without this the photo would paint over the quote's last words. */
  .quote__body {
    position: relative;
    z-index: 1;
  }
  /* This is a long executive quote in a column, not a pull quote, so it
     takes the lead measure rather than the quote measure — still a named
     step, and the column is narrower than it at this size, so the column
     governs. Justified per Nahian; `balance` would fight it. */
  .quote blockquote {
    max-width: var(--measure-tight);
    text-align: justify;
    text-wrap: normal;
  }
  /* The panel: out of the grid, against the section's right, top and
     bottom, 58% wide. Its left 45% is the fade. The crop is anchored at
     85% across, which keeps his face (~76% of the frame) in the solid
     part at every width: ~57% across the panel at 900px, where the
     section is tall and the crop tight, ~72% at 1440 and ~75% at 1920.
     The mask is static, composited once. */
  .quote :global(.quote__portrait) {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 58%;
    height: 100%;
    object-fit: cover;
    object-position: 85% 50%;
    /* A little zoom, pivoting on the right edge so the photo still meets
       it and his face comes left: ~74% → ~68% across the panel at 1440
       (Nahian, 2026-09-23). `scale`, not transform, so the reveal's
       transform cannot cancel it. The mask scales with the element, so
       its stops are written in the element's own space to land where
       the unzoomed fade did on screen — transparent at the panel's left
       edge, solid 45% in: stop = 1 − (1 − p) / 1.2. The section's
       overflow clips the zoom's top and bottom. */
    scale: 1.2;
    transform-origin: 100% 50%;
    -webkit-mask-image: linear-gradient(to right, transparent 16.7%, #000 54.2%);
    mask-image: linear-gradient(to right, transparent 16.7%, #000 54.2%);
  }
  /* Fade only: the reveal's 20px rise would open a gap along an edge
     that is meant to be the section's own. */
  .quote :global(.quote__portrait[data-reveal]) {
    transform: none;
  }
  .quote__attr {
    margin-top: var(--s-5);
    color: var(--on-night-2);
  }
  .quote__attr strong {
    display: block;
    color: var(--on-night);
    font-weight: 600;
  }

  /* ---- the journey wall: pinned, panned ---- */
  .wall {
    position: relative;
    height: calc(var(--vh) * 3.2);
    background: var(--night);
    color: var(--on-night);
  }
  .wall__pin {
    height: var(--vh);
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-content: center;
    gap: clamp(1rem, 2.5vh, 1.75rem);
    /* Tight chrome on purpose: the artwork is 6:1, so every pixel of
             height given back to it is six pixels of readable width. */
    padding-block: clamp(3rem, 7vh, 4.5rem);
  }
  .wall__head {
    text-align: center;
    padding-inline: var(--gutter);
  }
  /* The type step caps the headline at --measure-head, and a capped block
     sits at the start of its container — only the text inside it was
     centring, which pushed the headline to the left of the section while
     the eyebrow stayed in the middle. Centre the BOX too. */
  .wall__head h2 {
    margin-inline: auto;
  }
  .wall__eyebrow {
    color: var(--pink-lift);
    margin-bottom: var(--s-3);
  }
  .wall__viewport {
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  /* Edge to edge (Nahian, 2026-09-23): no side margin and no radius, so
     the wall starts flush with the left of the screen and the pan ends
     flush with the right — about.ts pans by the track's own width. */
  .wall__track {
    display: flex;
    will-change: transform;
  }
  .wall :global(.wall__img) {
    height: min(calc(var(--vh) * 0.64), 38rem);
    width: auto;
    max-width: none;
  }
  .wall__bar {
    width: min(28rem, 62vw);
    height: 2px;
    margin-inline: auto;
    background: var(--on-night-3);
    border-radius: var(--r-full);
    overflow: hidden;
  }
  .wall__fill {
    height: 100%;
    background: var(--pink);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  /* Reduced motion / no JS: no pin; the artwork scrolls under the finger. */
  :global(.no-js) .wall,
  .wall.wall--static {
    height: auto;
  }
  :global(.no-js) .wall__pin,
  .wall--static .wall__pin {
    height: auto;
  }
  :global(.no-js) .wall__viewport,
  .wall--static .wall__viewport {
    overflow-x: auto;
  }
  :global(.no-js) .wall__bar,
  .wall--static .wall__bar {
    display: none;
  }

  /* ---- voices ---- */
  .voices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }
  .voices__card {
    margin: 0;
    padding: clamp(1.5rem, 2.6vw, 2.25rem);
    border-radius: var(--r-lg);
    background: var(--paper);
    border: 1px solid var(--pink-line);
    display: flex;
    flex-direction: column;
  }
  .voices :global(.voices__face) {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: var(--r-full);
    object-fit: cover;
    object-position: 50% 22%;
    margin-bottom: var(--s-5);
    box-shadow:
      0 0 0 3px var(--paper),
      0 0 0 4px var(--pink-line);
  }
  .voices__card figcaption {
    display: contents;
  }
  .voices__tag {
    color: var(--pink);
    margin-bottom: var(--s-4);
  }
  .voices__quote {
    color: var(--ink);
    flex: 1;
  }
  .voices__who {
    margin-top: var(--s-5);
    color: var(--ink-3);
  }
  .voices__who strong {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }

  /* ---- careers: copy beside a picture ---- */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .split__title {
    margin-bottom: var(--s-4);
  }
  .split__lead {
    margin-bottom: var(--s-5);
  }
  .split__values-head {
    color: var(--ink-2);
    margin-bottom: var(--s-2);
  }
  .split__body {
    color: var(--ink-2);
  }
  .split__cta {
    margin-top: var(--s-6);
  }
  .split :global(.split__img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-lg);
    box-shadow: var(--e-3);
  }
  .careers__values {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.018em;
    color: var(--pink);
    margin-bottom: var(--s-5);
  }

  /* ---- the road ahead: the illustration full-bleed beneath the copy ---- */
  .road {
    padding-bottom: 0;
    overflow: hidden;
  }
  .road__head {
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
  .road__body {
    margin-top: var(--s-5);
    color: var(--on-night-2);
  }
  .road :global(.road__img) {
    width: 100%;
    height: auto;
    max-height: calc(var(--vh) * 0.62);
    object-fit: cover;
    object-position: 50% 42%;
    display: block;
  }

  @media (max-width: 1100px) {
    .investors {
      justify-content: center;
    }
  }

  @media (max-width: 767px) {
    /* One rhythm for every section on a phone. The road keeps its zero
             bottom — its illustration runs full-bleed off the foot of the
             section, and this rule comes after `.road` in the file. */
    .ab-section {
      padding-block: var(--section-pad-phone);
    }
    .road {
      padding-bottom: 0;
    }
    /* The mark under the copy, flying in from off the screen (Nahian,
       2026-09-23): larger than the frame and pulled past its left edge,
       so the wing and tail — behind it, it faces right — are cut off and
       the bird reads as going on beyond the screen. About a third of the
       drawing is hidden; the head lands at ~83% across. The
       PNG's ground is transparent, so the bleed shows no box. Overflow
       to the left cannot be scrolled to, so the page does not widen. */
    /* Even air around the drawing, not the file (Nahian, 2026-09-23):
       the PNG carries 7.28% of its height as transparent margin above
       the bird and 5.65% below — measured from its alpha — so at 128vw
       those are pulled back with negative margins, and the gap above
       and the section's space below are the same --s-6. */
    .revolution {
      grid-template-columns: 1fr;
      gap: var(--s-6);
      margin-bottom: var(--s-6);
    }
    .revolution :global(.revolution__mark) {
      width: 128vw;
      max-width: none;
      margin-inline-start: calc(-1 * var(--gutter) - 41vw);
      margin-top: calc(-0.0728 * 128vw);
      margin-bottom: calc(-0.0565 * 128vw);
    }
    .split {
      grid-template-columns: 1fr;
    }
    .split :global(.split__img) {
      order: -1;
      aspect-ratio: 16 / 10;
    }
    /* One column, the portrait above the quote. Justified here too
       (Nahian, 2026-09-23), with hyphenation on: at ~26 characters a
       line, justification alone opens rivers of word space, and letting
       long words break at the line end is what keeps the spacing even. */
    .quote {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .quote blockquote {
      hyphens: auto;
      -webkit-hyphens: auto;
    }
    /* The portrait dissolves into the section (Nahian, 2026-09-23): no
       edge the eye can close into a box. Out past the gutter on both
       sides and the section's top padding, so it is the section's own
       ground rather than a picture placed on it; its lower half fades
       into --night, where his dark suit already nearly is; and the quote
       starts inside the fade, so the words come up out of the photo.

       Square, not 6:7: a smaller enlargement of the 1200x669 landscape,
       so it stays sharper, and more of the wall around him. Anchored
       right, his face lands at ~57% across. The mask is static — it
       composites once, it is not animated. */
    .quote :global(.quote__portrait) {
      /* back in flow, above the quote — the desktop panel is absolute */
      position: static;
      width: calc(100% + 2 * var(--gutter));
      max-width: none;
      height: auto;
      aspect-ratio: 1;
      /* Its own anchor: the desktop panel's 85% put his face at ~69%
         across the square; 100% is the furthest left the frame allows
         without a gap at the right edge, ~57% (Nahian, 2026-09-23). */
      object-position: 100% 50%;
      /* …and the zoom takes it to the centre: 1.16 about the top-right
         corner puts his face at 50% across, the photo still flush with
         the right edge and the section's top. */
      scale: 1.16;
      transform-origin: 100% 0;
      margin-inline: calc(-1 * var(--gutter));
      margin-top: calc(-1 * var(--section-pad-phone));
      margin-bottom: calc(-1 * var(--s-9));
      border-radius: 0;
      /* Stops divided by the 1.16 zoom, so the fade still runs from 45%
         of the square to its foot on screen. */
      -webkit-mask-image: linear-gradient(to bottom, #000 38.8%, transparent 86.2%);
      mask-image: linear-gradient(to bottom, #000 38.8%, transparent 86.2%);
    }
    /* Three across, two rows (Nahian, 2026-09-20). A grid, not the
             desktop flex row: every mark gets the same cell and is centred in
             it, and `grid-auto-rows: 1fr` makes both rows the same height, so
             the six read as one block however tall each logo happens to be.
             about.ts still solves ONE divisor from the widest wordmark and the
             cell, so the area normalisation survives the narrower cell. */
    .investors {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 1fr;
      justify-items: center;
      align-items: center;
      gap: clamp(1.5rem, 5vw, 2.25rem) var(--s-4);
    }
    .wall {
      height: calc(var(--vh) * 2.6);
    }
    .wall :global(.wall__img) {
      height: calc(var(--vh) * 0.38);
    }
  }
</style>

