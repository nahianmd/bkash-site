  /* Reduced motion / no JS: no pin; the artwork scrolls under the finger. */
  :global(.no-js) .wall,
  .wall.wall--static {
    height: auto;
  }
  :global(.no-js) .wall__pin,
  .wall--static .wall__pin {
    height: auto;
  }
  :global(.no-js) .wall__viewport,
  .wall--static .wall__viewport {
    overflow-x: auto;
  }
  :global(.no-js) .wall__bar,
  .wall--static .wall__bar {
    display: none;
  }

  /* ---- voices ---- */
  .voices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }
  .voices__card {
    margin: 0;
    padding: clamp(1.5rem, 2.6vw, 2.25rem);
    border-radius: var(--r-lg);
    background: var(--paper);
    border: 1px solid var(--pink-line);
    display: flex;
    flex-direction: column;
  }
  .voices :global(.voices__face) {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: var(--r-full);
    object-fit: cover;
    object-position: 50% 22%;
    margin-bottom: var(--s-5);
    box-shadow:
      0 0 0 3px var(--paper),
      0 0 0 4px var(--pink-line);
  }
  .voices__card figcaption {
    display: contents;
  }
  .voices__tag {
    color: var(--pink);
    margin-bottom: var(--s-4);
  }
  .voices__quote {
    color: var(--ink);
    flex: 1;
  }
  .voices__who {
    margin-top: var(--s-5);
    color: var(--ink-3);
  }
  .voices__who strong {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }

  /* ---- careers: copy beside a picture ---- */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
