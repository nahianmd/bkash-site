---
/* The About shell.

   Exists so the nav's two-page behaviour is real and testable — the
   spec asks for exactly that and nothing more. About's own sections
   (stats, board, the CEO quote, the Journey Wall) come later, after
   the homepage.

   Note it does NOT place a [data-nav-dark-end] marker, so it gets a
   solid nav from the first paint. When its photographic banner is
   built, the banner opts in by placing that marker at the end of its
   dark region — the nav state follows the composition, not the page.
*/
import { Picture } from 'astro:assets';

import Base from '../layouts/Base.astro';
import banner from '../assets/img/about/banner.jpg';
---

<Base
  title="About bKash — Financial freedom for millions"
  description="A secure digital account where millions store value and decide how to use it."
  current="company"
>
  <main class="shell">
    {/* The worked example for the image convention in
        `src/styles/README.md`. AVIF then WebP, srcset from the
        configured breakpoints, and the one eager/high-priority
        image on this page because it is the LCP element.

        The caption sits on `.on-photo` — the only sanctioned way
        text goes on a photograph (design language Rule 3). */}
    <figure class="shell__banner">
      <Picture
        src={banner}
        formats={['avif', 'webp']}
        alt="bKash customers across Bangladesh"
        loading="eager"
        fetchpriority="high"
        sizes="100vw"
        class="shell__banner-img"
      />
      <figcaption class="on-photo shell__banner-cap">
        <p class="t-eyebrow">Documentary register</p>
        <p class="t-h3">Real light, real clutter, real faces</p>
      </figcaption>
    </figure>

    <div class="wrap shell__in">
      <p class="t-eyebrow">About bKash</p>
      <h1 class="t-h1">Empowering 85M Bangladeshis with financial freedom</h1>
      <p class="t-lead">
        Bridging the everyday economy and digital finance, bKash brought millions into the
        formal economy who now have controls on their own money.
      </p>
      <p class="t-body">
        This page is a shell. It proves the nav renders its current state on a second page and
        that the Support button is present on both, which the prototype's hand-duplicated markup
        got wrong (audit A7).
      </p>
      <blockquote class="t-quote shell__quote">
        The pull-quote step exists for the CEO quote, which was the least-designed moment on the
        page. This is a placeholder using it, not the quote itself.
      </blockquote>
      <p class="t-sm shell__link">
        <a href="/">Back to the homepage</a>
      </p>
    </div>
  </main>
</Base>

<style>
  .shell {
    padding-bottom: var(--s-10);
  }

  /* Clears the fixed header from the single source, --nav-h. */
  .shell__banner {
    position: relative;
    margin: 0;
    padding-top: var(--nav-h);
  }

  .shell__banner-img {
    width: 100%;
    /* A wide band at both widths rather than the source's own ratio,
             so the caption has somewhere to sit at 390px too. */
    aspect-ratio: 16 / 9;
    height: auto;
  }

  .shell__banner-cap {
    position: absolute;
    inset-inline: var(--gutter);
    bottom: var(--s-6);
    max-width: var(--measure-head);
  }

  .shell__banner-cap > * + * {
    margin-top: var(--s-2);
  }

  .shell__in {
    padding-top: var(--s-8);
  }

  .shell__in > * + * {
    margin-top: var(--s-4);
  }

  .shell__quote {
    margin-top: var(--s-6);
    padding-inline-start: var(--s-5);
    border-inline-start: 2px solid var(--pink);
    color: var(--ink-2);
  }

  .shell__link {
    margin-top: var(--s-6);
  }
</style>
