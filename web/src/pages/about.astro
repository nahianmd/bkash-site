  .split__title {
    margin-bottom: var(--s-4);
  }
  .split__lead {
    margin-bottom: var(--s-5);
  }
  .split__values-head {
    color: var(--ink-2);
    margin-bottom: var(--s-2);
  }
  .split__body {
    color: var(--ink-2);
  }
  .split__cta {
    margin-top: var(--s-6);
  }
  .split :global(.split__img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-lg);
