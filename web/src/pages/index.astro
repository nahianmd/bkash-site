---
/* The homepage shell.

   The pin-and-scrub smoke test that lived here is gone, as the spec
   and START-HERE both require: it existed to prove the scroll
   infrastructure end to end, and it has done that.

   The sections land here one at a time under the SDD loop. Copy across
   the page is placeholder until bKash's.
*/
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Bird from '../components/Bird.astro';
import People from '../components/People.astro';
import Services from '../components/Services.astro';
import ServicesDetail from '../components/ServicesDetail.astro';
---

<Base
  title="bKash — Financial freedom for millions"
  description="A secure digital account where millions store value and decide how to use it."
  current="home"
>
  <main>
    <Hero />
    <Bird />
    <People />
    <Services />
    <ServicesDetail />

  </main>
</Base>
