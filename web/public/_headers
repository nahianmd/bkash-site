# Cloudflare Pages / Netlify read this file.

# Nothing here is signed off for public use yet: refuse indexing at the
# header level too, and keep the page out of framing.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Astro's build hashes every filename in /_astro/, so these can never go
# stale — cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
